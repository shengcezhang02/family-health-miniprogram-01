.quick-add-overlay {
  position: fixed;
  z-index: 998;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(11, 30, 23, 0.42);
}

.quick-add-menu {
  position: fixed;
  z-index: 999;
  right: 24rpx;
  bottom: calc(134rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #ddd8cf;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(18, 57, 44, 0.22);
}

.quick-add-menu__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quick-add-menu__title {
  color: #202825;
  font-size: 32rpx;
  font-weight: 700;
}

.quick-add-menu__description {
  margin-top: 4rpx;
  color: #7c8581;
  font-size: 22rpx;
}

.quick-add-menu__item::after {
  border: 0;
}

.quick-add-menu__actions {
  display: flex;
  flex-wrap: wrap;
  row-gap: 24rpx;
  margin-top: 24rpx;
}

.quick-add-menu__item {
  display: flex;
  width: 25%;
  min-width: 0;
  flex: 0 0 25%;
  box-sizing: border-box;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: #35423d;
  text-align: center;
  line-height: 1;
  background: transparent;
}

.quick-add-menu__item-mark {
  position: relative;
  display: flex;
  width: 86rpx;
  height: 86rpx;
  overflow: hidden;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(86, 47, 40, 0.18);
  border-radius: 50%;
  background: linear-gradient(145deg, #e98173, #c9584d);
  box-shadow:
    inset 0 -7rpx 12rpx rgba(91, 34, 28, 0.13),
    0 8rpx 15rpx rgba(121, 68, 59, 0.2);
}

.quick-add-menu__item-highlight {
  position: absolute;
  top: 8rpx;
  left: 13rpx;
  width: 44rpx;
  height: 21rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  transform: rotate(-18deg);
}

.quick-add-menu__item-icon {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
}

.quick-add-menu__item--blood-pressure .quick-add-menu__item-mark {
  border-color: rgba(87, 41, 47, 0.2);
  background: linear-gradient(145deg, #d66b76, #a94753);
  box-shadow:
    inset 0 -7rpx 12rpx rgba(77, 23, 31, 0.13),
    0 8rpx 15rpx rgba(127, 51, 61, 0.2);
}

.quick-add-menu__item--blood-glucose .quick-add-menu__item-mark {
  border-color: rgba(37, 83, 107, 0.2);
  background: linear-gradient(145deg, #6696ad, #3f718a);
  box-shadow:
    inset 0 -7rpx 12rpx rgba(24, 62, 82, 0.13),
    0 8rpx 15rpx rgba(53, 88, 112, 0.2);
}

.quick-add-menu__item--medication .quick-add-menu__item-mark {
  border-color: rgba(47, 93, 81, 0.2);
  background: linear-gradient(145deg, #68a290, #3e7668);
  box-shadow:
    inset 0 -7rpx 12rpx rgba(29, 72, 61, 0.13),
    0 8rpx 15rpx rgba(46, 111, 104, 0.2);
}

.quick-add-menu__item--share .quick-add-menu__item-mark {
  border-color: rgba(77, 72, 119, 0.2);
  background: linear-gradient(145deg, #8580aa, #625c89);
  box-shadow:
    inset 0 -7rpx 12rpx rgba(47, 42, 77, 0.13),
    0 8rpx 15rpx rgba(75, 67, 114, 0.2);
}

.quick-add-menu__item--template .quick-add-menu__item-mark {
  border-color: rgba(105, 73, 30, 0.2);
  background: linear-gradient(145deg, #c59657, #9c6f35);
  box-shadow:
    inset 0 -7rpx 12rpx rgba(72, 47, 17, 0.13),
    0 8rpx 15rpx rgba(121, 83, 34, 0.2);
}

.quick-add-menu__item-title {
  font-size: 24rpx;
  font-weight: 700;
}

.main-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  align-items: flex-start;
  justify-content: space-around;
  padding: 12rpx 10rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #e5e0d8;
  background: rgba(255, 255, 255, 0.98);
}

.main-tab-bar__item {
  display: flex;
  min-width: 120rpx;
  flex: 1;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #66716d;
}

.main-tab-bar__icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: transparent;
}

.main-tab-bar__icon-image {
  width: 38rpx;
  height: 38rpx;
  opacity: 0.58;
}

.main-tab-bar__label {
  margin-top: 5rpx;
  font-size: 19rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.main-tab-bar__item--selected {
  color: #d95c4f;
  font-weight: 700;
}

.main-tab-bar__item--selected .main-tab-bar__icon {
  background: #f8e9e5;
}

.main-tab-bar__item--selected .main-tab-bar__icon-image {
  opacity: 1;
}

.main-tab-bar__item--action {
  position: relative;
  top: -24rpx;
}

.main-tab-bar__plus {
  position: relative;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
}

.main-tab-bar__plus-ring,
.main-tab-bar__plus-surface,
.main-tab-bar__plus-glyph {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.main-tab-bar__plus-ring {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #f6f3ee;
  box-shadow: 0 10rpx 22rpx rgba(46, 111, 104, 0.22);
}

.main-tab-bar__plus-surface {
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #2e6f68;
}

.main-tab-bar__plus-glyph {
  width: 44rpx;
  height: 44rpx;
  transform: translate(-50%, -50%) rotate(0);
  transition: transform 180ms ease-out;
}

.main-tab-bar__plus-glyph--open {
  transform: translate(-50%, -50%) rotate(45deg);
}

.main-tab-bar__plus-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 38rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.main-tab-bar__plus-line--horizontal {
  transform: translate(-50%, -50%);
}

.main-tab-bar__plus-line--vertical {
  transform: translate(-50%, -50%) rotate(90deg);
}
