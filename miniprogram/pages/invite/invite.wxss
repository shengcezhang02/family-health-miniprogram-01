.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 64rpx 40rpx;
  background:
    radial-gradient(circle at 90% 6%, rgba(105, 185, 151, 0.22), transparent 30%),
    linear-gradient(180deg, #f7faf8 0%, #edf4f0 100%);
}

.eyebrow {
  color: #2f765e;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.page-title {
  margin-top: 20rpx;
  color: #12392c;
  font-size: 50rpx;
  font-weight: 760;
  line-height: 1.3;
}

.page-description {
  margin-top: 24rpx;
  color: #60776f;
  font-size: 27rpx;
  line-height: 1.7;
}

.state-card,
.invite-card,
.join-card {
  margin-top: 42rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 54rpx rgba(45, 86, 69, 0.08);
}

.state-card {
  color: #60776f;
  font-size: 28rpx;
  text-align: center;
}

.state-card--error {
  color: #b34e49;
}

.state-card__title {
  font-size: 32rpx;
  font-weight: 700;
}

.state-card__description {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.invite-card__label,
.field-label,
.invite-preview__label {
  color: #60776f;
  font-size: 24rpx;
  font-weight: 650;
}

.invite-card__code {
  margin-top: 18rpx;
  color: #12392c;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
}

.invite-card__expiry,
.invite-preview__from {
  margin-top: 14rpx;
  color: #789087;
  font-size: 24rpx;
}

.code-input {
  height: 100rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dbe8e2;
  border-radius: 20rpx;
  color: #173b2f;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  background: #ffffff;
}

.invite-preview__name {
  margin-top: 12rpx;
  color: #12392c;
  font-size: 42rpx;
  font-weight: 760;
}

.join-name-field {
  margin-top: 32rpx;
}

.name-input {
  height: 88rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid #cfded8;
  border-radius: 14rpx;
  color: #173b2f;
  font-size: 29rpx;
  background: #ffffff;
}

.field-help {
  margin-top: 10rpx;
  color: #789087;
  font-size: 22rpx;
  line-height: 1.5;
}

.permission-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 42rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #e2ebe7;
  border-bottom: 1rpx solid #e2ebe7;
}

.permission-row__content {
  flex: 1;
}

.permission-row__title {
  color: #244c3e;
  font-size: 28rpx;
  font-weight: 700;
}

.permission-row__description {
  margin-top: 8rpx;
  color: #789087;
  font-size: 23rpx;
  line-height: 1.5;
}

.primary-button,
.secondary-button,
.danger-text-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.primary-button::after,
.secondary-button::after,
.danger-text-button::after {
  border: 0;
}

.primary-button {
  color: #ffffff;
  background: #2f765e;
}

.secondary-button {
  color: #2f765e;
  background: #e5f0eb;
}

.danger-text-button {
  color: #b34e49;
  background: transparent;
}

.error-message {
  margin-top: 24rpx;
  color: #b34e49;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
