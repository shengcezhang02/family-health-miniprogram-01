.profile-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 36rpx 64rpx;
  background:
    radial-gradient(circle at 90% 4%, rgba(105, 185, 151, 0.24), transparent 28%),
    linear-gradient(180deg, #f7faf8 0%, #edf4f0 100%);
}

.profile-header__eyebrow {
  color: #2f765e;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.profile-header__title {
  margin-top: 16rpx;
  color: #12392c;
  font-size: 52rpx;
  font-weight: 760;
}

.profile-header__description {
  margin-top: 18rpx;
  color: #657c73;
  font-size: 26rpx;
  line-height: 1.7;
}

.state-card,
.profile-card,
.permission-card,
.notice-card {
  margin-top: 30rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(47, 118, 94, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 42rpx rgba(45, 86, 69, 0.07);
}

.state-card__title {
  color: #244c3e;
  font-size: 30rpx;
  font-weight: 700;
}

.state-card__description {
  margin-top: 10rpx;
  color: #70857d;
  font-size: 25rpx;
}

.state-card--error {
  border-color: rgba(179, 78, 73, 0.18);
}

.picker-value,
.permission-card,
.profile-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f1f7f4;
}

.picker-value__main {
  color: #173b2f;
  font-size: 29rpx;
  font-weight: 700;
}

.picker-value__sub,
.permission-card__description {
  margin-top: 6rpx;
  color: #789087;
  font-size: 23rpx;
}

.picker-value__arrow {
  color: #6f887e;
  font-size: 36rpx;
}

.permission-card {
  gap: 24rpx;
}

.permission-card__body {
  flex: 1;
}

.permission-card__title,
.profile-card__title {
  color: #244c3e;
  font-size: 29rpx;
  font-weight: 700;
}

.permission-card__description {
  line-height: 1.55;
}

.notice-card {
  color: #825f22;
  font-size: 24rpx;
  line-height: 1.6;
  background: #fff8e9;
}

.profile-card__badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6e837b;
  font-size: 22rpx;
  background: #edf3f0;
}

.field-group {
  margin-top: 30rpx;
}

.field-label {
  color: #46655a;
  font-size: 25rpx;
  font-weight: 700;
}

.field-picker {
  margin-top: 12rpx;
  padding: 24rpx;
  border: 2rpx solid #dbe8e2;
  border-radius: 20rpx;
  color: #173b2f;
  font-size: 28rpx;
  background: #ffffff;
}

.field-picker--disabled {
  color: #687c75;
  background: #f1f4f2;
}

.primary-button,
.secondary-button {
  margin-top: 32rpx;
  border: 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #2f765e;
}

.secondary-button {
  color: #2f765e;
  background: #e0eee8;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.feedback {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.feedback--success {
  color: #245f49;
  background: #dfeee7;
}

.feedback--error {
  color: #a14541;
  background: #f9e8e7;
}
