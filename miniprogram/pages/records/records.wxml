<view class="records-shell">
  <view class="records-header">
    <view class="records-header__eyebrow">{{familyName}}</view>
    <view class="records-header__row">
      <view>
        <view class="records-header__title">健康记录</view>
        <view class="records-header__description">
          按实际发生时间，从新到旧排列。
        </view>
      </view>
      <button
        wx:if="{{status === 'ready'}}"
        id="timeline-quick-add-button"
        class="add-button"
        bindtap="onQuickAdd"
      >
        ＋ 记录
      </button>
    </view>
  </view>

  <view wx:if="{{status === 'ready'}}" class="records-tools">
    <button class="tool-button" bindtap="onOpenTemplates">
      管理自定义模板
    </button>
    <button class="tool-button" bindtap="onOpenDeletedRecords">
      已删除记录
    </button>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    <view class="state-card__title">正在加载健康记录</view>
    <view class="state-card__description">请稍候</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view class="state-card__title">暂时无法打开</view>
    <view class="state-card__description">{{errorMessage}}</view>
    <button
      wx:if="{{showGoHome}}"
      class="secondary-button"
      bindtap="onGoHome"
    >
      返回首页
    </button>
    <button
      wx:else
      class="secondary-button"
      bindtap="onRetry"
    >
      重新加载
    </button>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <view class="empty-state__icon">记</view>
    <view class="empty-state__title">还没有健康记录</view>
    <view class="empty-state__description">
      从一条体温、血压、血糖或用药记录开始。
    </view>
    <button
      id="empty-quick-add-button"
      class="primary-button"
      bindtap="onQuickAdd"
    >
      添加第一条记录
    </button>
  </view>

  <view wx:else class="timeline">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="timeline-item"
    >
      <view class="timeline-item__dot"></view>
      <view
        id="record-card-{{item.id}}"
        class="record-card"
        data-record-id="{{item.id}}"
        bindtap="onOpenRecord"
      >
        <view class="record-card__top">
          <view>
            <view class="record-card__template">
              {{item.templateNameSnapshot}}
            </view>
            <view class="record-card__subject">
              {{item.displaySubjectName}}
            </view>
          </view>
          <view class="record-card__time">{{item.displayOccurredAt}}</view>
        </view>
        <view class="record-card__values">
          <view
            wx:for="{{item.displayFields}}"
            wx:for-item="field"
            wx:key="key"
            class="record-value"
          >
            <view class="record-value__label">{{field.label}}</view>
            <view class="record-value__content">{{field.value}}</view>
          </view>
        </view>
        <view wx:if="{{item.remark}}" class="record-card__remark">
          备注：{{item.remark}}
        </view>
        <view class="record-card__open">查看与编辑 ›</view>
      </view>
    </view>
  </view>
</view>
