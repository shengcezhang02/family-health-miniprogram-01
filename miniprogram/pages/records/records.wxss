.records-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 36rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f6f3ee;
}

.records-header__eyebrow {
  color: #d95c4f;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.records-header__row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.records-header__title {
  color: #202825;
  font-size: 52rpx;
  font-weight: 750;
}

.records-header__description {
  margin-top: 10rpx;
  color: #66716d;
  font-size: 24rpx;
}

.add-button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  background: #2e6f68;
}

.add-button::after,
.primary-button::after,
.secondary-button::after {
  border: 0;
}

.records-tools {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.tool-button {
  flex: 1;
  margin: 0;
  border: 0;
  border: 1rpx solid #d8d3cb;
  border-radius: 12rpx;
  color: #3e4b46;
  font-size: 23rpx;
  background: #ffffff;
}

.tool-button::after {
  border: 0;
}

.state-card,
.empty-state {
  margin-top: 64rpx;
  padding: 42rpx 34rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  text-align: center;
  background: #ffffff;
}

.dashboard-card {
  margin-top: 34rpx;
  padding: 28rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 18rpx;
  background: #ffffff;
}

.dashboard-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dashboard-card__type {
  color: #4d6f8d;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dashboard-card__title {
  margin-top: 6rpx;
  color: #202825;
  font-size: 34rpx;
  font-weight: 700;
}

.dashboard-card__filter {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #66716d;
  font-size: 20rpx;
  background: #edf2f5;
}

.empty-state--inside-card {
  margin-top: 28rpx;
  padding: 34rpx 24rpx;
  box-shadow: none;
  background: #f7f5f1;
}

.state-card__title,
.empty-state__title {
  color: #202825;
  font-size: 31rpx;
  font-weight: 700;
}

.state-card__description,
.empty-state__description {
  margin-top: 14rpx;
  color: #66716d;
  font-size: 25rpx;
  line-height: 1.65;
}

.state-card--error {
  border: 1rpx solid rgba(179, 78, 73, 0.16);
}

.empty-state__icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  margin: 0 auto 26rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #4d6f8d;
  font-size: 42rpx;
  background: #e8eef3;
}

.primary-button,
.secondary-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #d95c4f;
}

.secondary-button {
  color: #2e6f68;
  background: #e7f0ed;
}

.timeline {
  margin-top: 30rpx;
}

.timeline-item {
  position: relative;
  padding: 0 0 28rpx 30rpx;
  border-left: 2rpx solid #d8d3cb;
}

.timeline-item:last-child {
  border-left-color: transparent;
}

.timeline-item__dot {
  position: absolute;
  top: 28rpx;
  left: -10rpx;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #d95c4f;
}

.record-card {
  padding: 28rpx;
  border: 1rpx solid #e5e0d8;
  border-radius: 14rpx;
  background: #ffffff;
}

.record-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-card__template {
  color: #202825;
  font-size: 31rpx;
  font-weight: 700;
}

.record-card__subject {
  margin-top: 6rpx;
  color: #66716d;
  font-size: 24rpx;
}

.record-card__time {
  color: #7c8581;
  font-size: 22rpx;
  white-space: nowrap;
}

.record-card__values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.record-value {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  border-radius: 10rpx;
  background: #edf2f5;
}

.record-value__label {
  color: #66716d;
  font-size: 22rpx;
}

.record-value__content {
  margin-top: 4rpx;
  color: #202825;
  font-size: 31rpx;
  font-weight: 700;
}

.record-card__remark {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e0d8;
  color: #66716d;
  font-size: 24rpx;
  line-height: 1.6;
}

.record-card__open {
  margin-top: 18rpx;
  color: #d95c4f;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}
