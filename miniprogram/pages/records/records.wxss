.records-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 36rpx 64rpx;
  background:
    radial-gradient(circle at 90% 4%, rgba(105, 185, 151, 0.18), transparent 28%),
    #f4f7f5;
}

.records-header__eyebrow {
  color: #2f765e;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.records-header__row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.records-header__title {
  color: #12392c;
  font-size: 50rpx;
  font-weight: 760;
}

.records-header__description {
  margin-top: 10rpx;
  color: #70857d;
  font-size: 24rpx;
}

.add-button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 26rpx;
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  background: #2f765e;
}

.add-button::after,
.primary-button::after,
.secondary-button::after {
  border: 0;
}

.state-card,
.empty-state {
  margin-top: 64rpx;
  padding: 42rpx 34rpx;
  border-radius: 28rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 54rpx rgba(45, 86, 69, 0.07);
}

.state-card__title,
.empty-state__title {
  color: #244c3e;
  font-size: 31rpx;
  font-weight: 700;
}

.state-card__description,
.empty-state__description {
  margin-top: 14rpx;
  color: #70857d;
  font-size: 25rpx;
  line-height: 1.65;
}

.state-card--error {
  border: 1rpx solid rgba(179, 78, 73, 0.16);
}

.empty-state__icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  margin: 0 auto 26rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #2f765e;
  font-size: 42rpx;
  background: #dfeee7;
}

.primary-button,
.secondary-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #2f765e;
}

.secondary-button {
  color: #2f765e;
  background: #e3f0ea;
}

.timeline {
  margin-top: 44rpx;
}

.timeline-item {
  position: relative;
  padding: 0 0 28rpx 30rpx;
  border-left: 3rpx solid #cfe3da;
}

.timeline-item:last-child {
  border-left-color: transparent;
}

.timeline-item__dot {
  position: absolute;
  top: 28rpx;
  left: -10rpx;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid #f4f7f5;
  border-radius: 50%;
  background: #2f765e;
}

.record-card {
  padding: 30rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 36rpx rgba(45, 86, 69, 0.07);
}

.record-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-card__template {
  color: #244c3e;
  font-size: 31rpx;
  font-weight: 700;
}

.record-card__subject {
  margin-top: 6rpx;
  color: #688278;
  font-size: 24rpx;
}

.record-card__time {
  color: #7f938b;
  font-size: 22rpx;
  white-space: nowrap;
}

.record-card__values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.record-value {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #eef5f1;
}

.record-value__label {
  color: #70857d;
  font-size: 22rpx;
}

.record-value__content {
  margin-top: 4rpx;
  color: #173b2f;
  font-size: 31rpx;
  font-weight: 700;
}

.record-card__remark {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e6eeea;
  color: #60776f;
  font-size: 24rpx;
  line-height: 1.6;
}
