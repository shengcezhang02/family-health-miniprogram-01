.records-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 34rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f4f1eb;
}

.records-header__eyebrow {
  color: #c65b4f;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.records-header__row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 14rpx;
}

.records-header__title {
  color: #202825;
  font-size: 50rpx;
  font-weight: 750;
}

.records-header__description {
  margin-top: 9rpx;
  color: #66716d;
  font-size: var(--display-body-size);
}

.switch-button,
.tool-button,
.primary-button,
.secondary-button {
  margin: 0;
  border: 0;
  border-radius: 10rpx;
  font-weight: 700;
}

.switch-button::after,
.tool-button::after,
.primary-button::after,
.secondary-button::after {
  border: 0;
}

.switch-button {
  flex: 0 0 auto;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  background: #2e6f68;
}

.records-tools {
  display: flex;
  gap: 14rpx;
  margin-top: 26rpx;
}

.tool-button {
  flex: 1;
  border: 1rpx solid #d4cec5;
  color: #3e4b46;
  font-size: 23rpx;
  background: #ffffff;
}

.tool-button--primary {
  border-color: #2e6f68;
  color: #ffffff;
  background: #2e6f68;
}

.sync-indicator {
  position: fixed;
  top: 18rpx;
  right: 24rpx;
  z-index: 30;
  max-width: 430rpx;
  overflow: hidden;
  padding: 9rpx 14rpx;
  border: 1rpx solid #ead9ad;
  border-radius: 7rpx;
  color: #7b641d;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: rgba(250, 245, 231, 0.96);
  box-shadow: 0 4rpx 12rpx rgba(43, 48, 45, 0.08);
}

.state-card,
.empty-dashboard {
  margin-top: 54rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid #ded8cf;
  border-radius: 14rpx;
  text-align: center;
  background: #ffffff;
}

.state-card--error {
  border-color: rgba(179, 78, 73, 0.22);
}

.state-card__title,
.empty-dashboard__title {
  color: #202825;
  font-size: 31rpx;
  font-weight: 700;
}

.state-card__description,
.empty-dashboard__description {
  margin-top: 12rpx;
  color: #66716d;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-dashboard__mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 22rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #4d6f8d;
  font-size: 34rpx;
  background: #e7edf1;
}

.primary-button,
.secondary-button {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.primary-button {
  color: #ffffff;
  background: #c65b4f;
}

.secondary-button {
  color: #2e6f68;
  background: #e5efeb;
}

.dashboard-list {
  margin-top: 28rpx;
}

.dashboard-card {
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid #ded8cf;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(48, 55, 51, 0.06);
}

.dashboard-card__header {
  display: block;
  padding: var(--display-card-padding);
  border-bottom: 1rpx solid #ebe6df;
  background: linear-gradient(135deg, #f8faf9 0, #ffffff 62%);
}

.dashboard-card__heading {
  min-width: 0;
  flex: 1;
}

.dashboard-card__type {
  display: inline-flex;
  padding: 4rpx 9rpx;
  border-radius: 7rpx;
  color: #59736c;
  font-size: var(--display-meta-size);
  font-weight: 700;
  letter-spacing: 1.5rpx;
  background: #e9f0ed;
}

.dashboard-card--latest_data .dashboard-card__type { color: #805a25; background: #f5ecdd; }
.dashboard-card--reminder_completion .dashboard-card__type { color: #934d47; background: #f7e7e5; }
.dashboard-card--recurring_rules .dashboard-card__type { color: #65577d; background: #eeeaf5; }
.dashboard-card--blood-pressure .dashboard-card__header,
.dashboard-card--rose .dashboard-card__header { background: linear-gradient(135deg, #fff8f9 0, #fff 62%); }
.dashboard-card--blood-glucose .dashboard-card__header,
.dashboard-card--blue .dashboard-card__header { background: linear-gradient(135deg, #f6fbfd 0, #fff 62%); }
.dashboard-card--medication .dashboard-card__header,
.dashboard-card--green .dashboard-card__header { background: linear-gradient(135deg, #f6fbf8 0, #fff 62%); }
.dashboard-card--temperature .dashboard-card__header,
.dashboard-card--amber .dashboard-card__header { background: linear-gradient(135deg, #fffaf2 0, #fff 62%); }
.dashboard-card--purple .dashboard-card__header { background: linear-gradient(135deg, #f9f7fc 0, #fff 62%); }
.dashboard-card--teal .dashboard-card__header { background: linear-gradient(135deg, #f5fbfa 0, #fff 62%); }

.dashboard-card__title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.dashboard-card__title {
  min-width: 0;
  overflow: hidden;
  color: #202825;
  font-size: var(--display-card-title-size);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-card__open {
  color: #c65b4f;
  font-size: 27rpx;
  font-weight: 700;
}

.dashboard-card__filter {
  margin-top: 6rpx;
  overflow: hidden;
  color: #596a64;
  font-size: var(--display-meta-size);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-card__quick-filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 17rpx;
}

.dashboard-card__quick-filters picker {
  min-width: 0;
}

.quick-filter {
  display: flex;
  min-width: 0;
  min-height: 60rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 12rpx;
  border: 2rpx solid #5d8178;
  border-radius: 9rpx;
  color: #245c54;
  font-size: var(--display-meta-size);
  font-weight: 700;
  background: #f4faf7;
  box-shadow:
    inset 0 0 0 1rpx rgba(46, 111, 104, 0.08),
    0 4rpx 10rpx rgba(46, 111, 104, 0.12);
}

.quick-filter--range {
  border-color: #b8833f;
  color: #76501e;
  background: #fff9ed;
  box-shadow:
    inset 0 0 0 1rpx rgba(183, 129, 63, 0.08),
    0 4rpx 10rpx rgba(183, 129, 63, 0.12);
}

.quick-filter__icon {
  display: flex;
  width: 25rpx;
  height: 25rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 15rpx;
  background: #2e6f68;
}

.quick-filter--range .quick-filter__icon {
  background: #a76f2c;
}

.quick-filter__chevron {
  flex: 0 0 auto;
  margin-left: auto;
  color: inherit;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1;
}

.quick-filter__value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-empty {
  padding: 34rpx 24rpx;
  color: #78817e;
  font-size: 23rpx;
  text-align: center;
  background: #faf9f6;
}

.card-empty--small {
  padding: 22rpx;
}

.compact-list {
  padding: 0 22rpx 8rpx;
}

.record-row,
.reminder-row,
.rule-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
  padding: var(--display-row-padding) 2rpx;
  border-bottom: 1rpx solid #ebe6df;
}

.record-row,
.reminder-row {
  border-left: 6rpx solid #70698d;
  padding-left: 14rpx;
}

.record-row--blood-pressure,
.reminder-row--blood-pressure {
  border-left-color: #b75460;
  background: linear-gradient(90deg, #fbefef 0, #ffffff 26%);
}

.record-row--blood-glucose,
.reminder-row--blood-glucose {
  border-left-color: #437893;
  background: linear-gradient(90deg, #edf5f8 0, #ffffff 26%);
}

.record-row--medication,
.reminder-row--medication {
  border-left-color: #427a6b;
  background: linear-gradient(90deg, #edf6f2 0, #ffffff 26%);
}

.record-row--temperature,
.reminder-row--temperature {
  border-left-color: #a8732f;
  background: linear-gradient(90deg, #fbf4e7 0, #ffffff 26%);
}

.record-row--rose,
.reminder-row--rose { border-left-color: #b65d66; background: linear-gradient(90deg, #fbefef 0, #fff 26%); }
.record-row--blue,
.reminder-row--blue { border-left-color: #4d7598; background: linear-gradient(90deg, #edf4f8 0, #fff 26%); }
.record-row--green,
.reminder-row--green { border-left-color: #4f8067; background: linear-gradient(90deg, #edf6f1 0, #fff 26%); }
.record-row--amber,
.reminder-row--amber { border-left-color: #a87832; background: linear-gradient(90deg, #fbf4e7 0, #fff 26%); }
.record-row--purple,
.reminder-row--purple { border-left-color: #75658c; background: linear-gradient(90deg, #f2f0f8 0, #fff 26%); }
.record-row--teal,
.reminder-row--teal { border-left-color: #347a77; background: linear-gradient(90deg, #eaf5f3 0, #fff 26%); }

.record-row__content {
  min-width: 0;
  flex: 1;
}

.record-row__main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.record-row__meta,
.reminder-row__created {
  margin-top: 6rpx;
  overflow: hidden;
  color: #78827e;
  font-size: var(--display-meta-size);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-row:last-child,
.reminder-row:last-child,
.rule-row:last-child {
  border-bottom: 0;
}

.record-row__identity {
  display: flex;
  min-width: 0;
  max-width: 240rpx;
  align-items: baseline;
  gap: 5rpx;
}

.record-row__name,
.reminder-row__name,
.rule-row__name {
  color: #202825;
  font-size: var(--display-body-size);
  font-weight: 700;
}

.record-row__name {
  flex: 0 0 auto;
  white-space: nowrap;
}

.record-row__member,
.reminder-row__member {
  overflow: hidden;
  color: #6e7975;
  font-size: var(--display-meta-size);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-row__values {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-wrap: wrap;
  gap: 5rpx 10rpx;
}

.record-row__value {
  color: #30433d;
  font-size: var(--display-body-size);
  font-weight: 650;
}

.record-row__time,
.reminder-row__time {
  flex: 0 0 auto;
  color: #86908c;
  font-size: var(--display-meta-size);
  white-space: nowrap;
}

.latest-grid {
  display: grid;
  gap: 1rpx;
  background: #ebe6df;
}

.latest-panel {
  padding: 21rpx 24rpx;
  background: #ffffff;
}

.latest-panel__meta {
  color: #78827e;
  font-size: 20rpx;
}

.latest-value {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 10rpx;
}

.latest-value__number {
  color: #2b3c37;
  font-size: 38rpx;
  font-weight: 750;
}

.latest-value__label {
  margin-left: 9rpx;
  color: #65716d;
  font-size: 20rpx;
}

.latest-value__change {
  color: #9b6a32;
  font-size: 20rpx;
}

.trend-list {
  padding: 4rpx 22rpx 18rpx;
}

.trend-series {
  padding: 17rpx 0 5rpx;
  border-bottom: 1rpx solid #ebe6df;
}

.trend-series:last-child {
  border-bottom: 0;
}

.trend-series__summary,
.trend-series__range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.trend-series__label {
  color: #54635e;
  font-size: 21rpx;
}

.trend-series__latest {
  color: #2e6f68;
  font-size: 30rpx;
  font-weight: 750;
}

.trend-chart {
  display: flex;
  height: 128rpx;
  margin-top: 12rpx;
  align-items: stretch;
}

.trend-y-axis {
  position: relative;
  width: 48rpx;
  flex: 0 0 48rpx;
}

.trend-y-tick {
  position: absolute;
  right: 8rpx;
  color: #7c8783;
  font-size: 16rpx;
  line-height: 1;
  transform: translateY(50%);
}

.trend-plot {
  position: relative;
  display: flex;
  min-width: 0;
  flex: 1;
  height: 128rpx;
  align-items: stretch;
  border-top: 1rpx solid #e7e2db;
  border-bottom: 1rpx solid #e7e2db;
  background: repeating-linear-gradient(
    to bottom,
    #faf9f6 0,
    #faf9f6 31rpx,
    #ede9e2 32rpx
  );
}

.trend-reference {
  position: absolute;
  right: 0;
  left: 0;
  z-index: 3;
  height: 0;
  pointer-events: none;
}

.trend-reference__line {
  border-top: 2rpx dashed rgba(182, 91, 76, 0.78);
}

.trend-reference__label {
  position: absolute;
  right: 4rpx;
  bottom: 5rpx;
  padding: 1rpx 5rpx;
  color: #a14f45;
  font-size: 15rpx;
  background: rgba(255, 250, 246, 0.88);
}

.trend-point-slot {
  position: relative;
  min-width: 20rpx;
  flex: 1;
}

.trend-line {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: 1;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background: #2e6f68;
}

.trend-point {
  position: absolute;
  left: 50%;
  z-index: 2;
  width: 13rpx;
  height: 13rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #2e6f68;
  box-shadow: 0 0 0 2rpx #2e6f68;
  transform: translate(-50%, 50%);
}

.trend-series__range {
  margin-top: 7rpx;
  padding-left: 48rpx;
  color: #8a938f;
  font-size: 17rpx;
}

.completion-summary {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 24rpx;
  background: #fbf4f1;
}

.completion-summary__rate {
  flex: 0 0 auto;
  color: #b9554c;
  font-size: 44rpx;
  font-weight: 780;
}

.completion-summary__copy {
  flex: 1;
  color: #635f5b;
  font-size: 21rpx;
}

.completion-progress {
  height: 9rpx;
  overflow: hidden;
  margin-top: 9rpx;
  background: #e8dcd7;
}

.completion-progress__value {
  height: 100%;
  background: #be6259;
}

.reminder-row,
.rule-row {
  justify-content: space-between;
}

.reminder-row__right {
  flex: 0 0 auto;
  text-align: right;
}

.reminder-row__status,
.rule-row__status {
  color: #b9554c;
  font-size: 20rpx;
  font-weight: 700;
}

.rule-row__main {
  min-width: 0;
  flex: 1;
}

.rule-row__schedule {
  margin-top: 5rpx;
  color: #6e7975;
  font-size: 20rpx;
}
