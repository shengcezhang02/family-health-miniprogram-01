<view class="member-shell">
  <view class="page-header__eyebrow">FAMILY · MEMBER</view>
  <view class="page-header__title">家庭成员</view>
  <view class="page-header__description">
    查看成员信息和健康档案。管理员身份不影响健康档案代管权限。
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    正在读取成员信息…
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view>{{errorMessage}}</view>
    <button class="secondary-button" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
    <view class="member-card">
      <view class="member-card__avatar">
        {{member.avatarText}}
      </view>
      <view class="member-card__name">
        {{member.displayName}}{{member.isSelf ? "（我）" : ""}}
      </view>
      <view class="role-badge">
        {{member.role === "admin" ? "管理员" : "普通成员"}}
      </view>
    </view>

    <view wx:if="{{notice}}" class="feedback feedback--success">
      {{notice}}
    </view>
    <view wx:if="{{errorMessage}}" class="feedback">
      {{errorMessage}}
    </view>

    <view class="section">
      <view class="section__title">健康操作</view>
      <button class="primary-button" bindtap="onOpenProfile">
        查看健康档案
      </button>
      <view class="section__hint">
        只有对方明确允许当前家庭代管时，其他成员才能修改档案。
      </view>
    </view>

    <view
      wx:if="{{member.canPromote || member.canRemove}}"
      class="section"
    >
      <view class="section__title">管理员操作</view>
      <button
        wx:if="{{member.canPromote}}"
        class="secondary-button"
        disabled="{{processing}}"
        bindtap="onPromoteMember"
      >
        提升为管理员
      </button>
      <button
        wx:if="{{member.canRemove}}"
        class="danger-button"
        disabled="{{processing}}"
        bindtap="onRemoveMember"
      >
        移出家庭
      </button>
    </view>

    <view
      wx:if="{{member.role === 'admin' && !member.isSelf}}"
      class="rule-note"
    >
      不能移除另一名管理员。对方需要先在自己的家庭管理页主动降级。
    </view>
  </block>
</view>
