<view class="daily-shell">
  <view class="daily-header">
    <view class="daily-header__eyebrow">DAILY · {{familyName || "家庭健康"}}</view>
    <view class="daily-header__title">每日健康</view>
    <view class="daily-header__description">
      一家人的记录、提醒与健康节奏，都按日期放在这里。
    </view>
  </view>

  <view class="date-navigator">
    <button
      id="daily-previous-date"
      class="date-navigator__side"
      bindtap="onPreviousDate"
    >
      <text class="date-navigator__arrow">‹</text>
      <text>前一天</text>
    </button>
    <picker
      class="date-navigator__picker"
      mode="date"
      value="{{date}}"
      bindchange="onDateChange"
    >
      <view id="daily-date-picker" class="date-navigator__selected">
        <view class="date-navigator__copy">
          <view class="date-navigator__title">{{dateTitle}}</view>
          <view class="date-navigator__subtitle">{{dateSubtitle}}</view>
        </view>
        <view class="date-navigator__calendar">日</view>
      </view>
    </picker>
    <button
      id="daily-next-date"
      class="date-navigator__side date-navigator__side--next"
      bindtap="onNextDate"
    >
      <text>后一天</text>
      <text class="date-navigator__arrow">›</text>
    </button>
  </view>
  <button
    wx:if="{{date !== todayDate}}"
    class="today-button"
    bindtap="onToday"
  >
    回到今天
  </button>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    <view class="state-card__title">正在加载当天健康事项</view>
    <view class="state-card__description">请稍候</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view class="state-card__title">暂时无法打开</view>
    <view class="state-card__description">{{errorMessage}}</view>
    <button
      wx:if="{{showGoFamily}}"
      class="secondary-button"
      bindtap="onGoFamily"
    >
      前往我和家庭
    </button>
    <button wx:else class="secondary-button" bindtap="onRetry">
      重新加载
    </button>
  </view>

  <view wx:else>
    <view class="quick-actions">
      <button
        id="daily-add-reminder-button"
        class="primary-button"
        bindtap="onAddReminder"
      >
        ＋ 新建提醒
      </button>
      <button
        id="daily-add-record-button"
        class="secondary-button"
        bindtap="onAddRecord"
      >
        添加记录
      </button>
    </view>

    <view class="section">
      <view class="section__title">提醒</view>
      <view wx:if="{{reminders.length === 0}}" class="empty-card">
        这一天还没有提醒
      </view>
      <view
        wx:for="{{reminders}}"
        wx:key="id"
        class="health-card reminder-card"
      >
        <view class="health-card__top">
          <view>
            <view class="health-card__title">{{item.templateNameSnapshot}}</view>
            <view class="health-card__subject">{{item.displaySubjectName}}</view>
          </view>
          <view class="status-badge status-badge--{{item.status}}">
            {{item.displayStatus}}
          </view>
        </view>
        <view class="health-card__time">计划 {{item.displayPlannedAt}}</view>
        <view wx:if="{{item.remark}}" class="health-card__remark">
          {{item.remark}}
        </view>
        <view class="card-actions">
          <button
            wx:if="{{item.canCheckIn}}"
            id="check-in-reminder-{{item.id}}"
            class="card-button card-button--primary"
            data-reminder-id="{{item.id}}"
            bindtap="onCheckInReminder"
          >
            打卡
          </button>
          <button
            wx:if="{{item.canCheckIn}}"
            id="edit-reminder-{{item.id}}"
            class="card-button"
            data-reminder-id="{{item.id}}"
            bindtap="onEditReminder"
          >
            修改
          </button>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__title">记录</view>
      <view wx:if="{{records.length === 0}}" class="empty-card">
        这一天还没有健康记录
      </view>
      <view
        wx:for="{{records}}"
        wx:key="id"
        class="health-card"
        data-record-id="{{item.id}}"
        bindtap="onOpenRecord"
      >
        <view class="health-card__top">
          <view>
            <view class="health-card__title">{{item.templateNameSnapshot}}</view>
            <view class="health-card__subject">{{item.displaySubjectName}}</view>
          </view>
          <view class="health-card__time">{{item.displayOccurredAt}}</view>
        </view>
        <view class="field-list">
          <view
            wx:for="{{item.displayFields}}"
            wx:for-item="field"
            wx:key="key"
            class="field-value"
          >
            {{field.label}}：{{field.value}}
          </view>
        </view>
        <view wx:if="{{item.remark}}" class="health-card__remark">
          {{item.remark}}
        </view>
      </view>
    </view>
  </view>
</view>
