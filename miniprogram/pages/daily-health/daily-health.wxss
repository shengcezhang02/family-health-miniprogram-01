.daily-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 36rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f6f3ee;
}

.daily-header__eyebrow {
  color: #d95c4f;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.health-card__top,
.quick-actions,
.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.daily-header__title {
  margin-top: 10rpx;
  color: #202825;
  font-size: 52rpx;
  font-weight: 750;
}

.daily-header__description {
  margin-top: 8rpx;
  color: #66716d;
  font-size: var(--display-body-size);
  line-height: 1.55;
}

.date-navigator {
  display: flex;
  align-items: stretch;
  margin-top: 34rpx;
  overflow: hidden;
  border: 1rpx solid #d8d3cb;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(37, 45, 41, 0.06);
}

.date-navigator__side {
  display: flex;
  min-width: 0;
  width: 136rpx;
  flex: 0 0 136rpx;
  min-height: 106rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 0;
  border-radius: 0;
  color: #66716d;
  font-size: 21rpx;
  background: #ffffff;
}

.date-navigator__side::after,
.today-button::after {
  border: 0;
}

.date-navigator__side--next {
  justify-content: center;
}

.date-navigator__arrow {
  color: #d95c4f;
  font-size: 38rpx;
  line-height: 1;
}

.date-navigator__picker {
  min-width: 0;
  flex: 1;
  border-right: 1rpx solid #e2ddd5;
  border-left: 1rpx solid #e2ddd5;
}

.date-navigator__selected {
  display: flex;
  min-height: 90rpx;
  margin: 8rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border: 2rpx solid #8ab0a6;
  border-radius: 10rpx;
  background: #eaf3f0;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.78);
}

.date-navigator__copy {
  min-width: 0;
  text-align: center;
}

.date-navigator__title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}

.date-navigator__title {
  color: #202825;
  font-size: 27rpx;
  font-weight: 750;
}

.date-navigator__subtitle {
  margin-top: 4rpx;
  color: #7c8581;
  font-size: 19rpx;
  white-space: nowrap;
}

.date-navigator__calendar {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: #d95c4f;
}

.today-button {
  width: auto;
  margin: 14rpx 0 0 auto;
  padding: 8rpx 18rpx;
  border: 0;
  border-radius: 10rpx;
  color: #2e6f68;
  font-size: 21rpx;
  line-height: 1.5;
  background: #e7f0ed;
}

.state-card,
.empty-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  background: #ffffff;
}

.date-navigator__chevron {
  color: #2e6f68;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.health-card {
  position: relative;
  margin-top: 12rpx;
  padding: var(--display-row-padding) var(--display-card-padding);
  border: 1rpx solid #e2ddd5;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(48, 55, 51, 0.045);
}

.health-card.health-card--blood-pressure {
  border-color: #ead8da;
  background: linear-gradient(90deg, #f9e8ea 0%, #fcf5f6 48%, #ffffff 80%);
}

.health-card.health-card--blood-glucose {
  border-color: #d7e4ea;
  background: linear-gradient(90deg, #e8f2f6 0%, #f5fafc 48%, #ffffff 80%);
}

.health-card.health-card--medication {
  border-color: #d6e5df;
  background: linear-gradient(90deg, #e7f2ed 0%, #f5faf7 48%, #ffffff 80%);
}

.health-card.health-card--temperature {
  border-color: #eadfcf;
  background: linear-gradient(90deg, #f7eddc 0%, #fcf7ee 48%, #ffffff 80%);
}

.health-card.health-card--rose { border-color: #ead8da; background: linear-gradient(90deg, #f9e8ea 0%, #fcf5f6 48%, #fff 80%); }
.health-card.health-card--blue { border-color: #d7e3ec; background: linear-gradient(90deg, #e8f0f7 0%, #f5f8fb 48%, #fff 80%); }
.health-card.health-card--green { border-color: #d8e5dc; background: linear-gradient(90deg, #e9f2ec 0%, #f6faf7 48%, #fff 80%); }
.health-card.health-card--amber { border-color: #e9dfcf; background: linear-gradient(90deg, #f6ecd9 0%, #fcf7ee 48%, #fff 80%); }
.health-card.health-card--purple { border-color: #e0dce8; background: linear-gradient(90deg, #eeeaf5 0%, #f8f6fb 48%, #fff 80%); }
.health-card.health-card--teal { border-color: #d4e4e2; background: linear-gradient(90deg, #e3f0ee 0%, #f4f9f8 48%, #fff 80%); }
.health-card.health-card--custom-color { border-color: #e0dce8; background: linear-gradient(90deg, #eeeaf5 0%, #f8f6fb 48%, #fff 80%); }

.health-card__title {
  display: inline-flex;
  padding: 4rpx 10rpx;
  border-radius: 7rpx;
  line-height: 1.3;
  background: #f1eee9;
}

.health-card--blood-pressure .health-card__title,
.health-card--rose .health-card__title { color: #93454f; background: #f7e7e9; }
.health-card--blood-glucose .health-card__title,
.health-card--blue .health-card__title { color: #376882; background: #e7f0f4; }
.health-card--medication .health-card__title,
.health-card--green .health-card__title { color: #356b59; background: #e7f1ed; }
.health-card--temperature .health-card__title,
.health-card--amber .health-card__title { color: #855b24; background: #f6eddc; }
.health-card--purple .health-card__title { color: #65577d; background: #eeeaf5; }
.health-card--teal .health-card__title { color: #286964; background: #e3f0ee; }

.state-card {
  margin-top: 60rpx;
  text-align: center;
}

.state-card__title,
.section__title,
.health-card__title {
  color: #202825;
  font-size: var(--display-card-title-size);
  font-weight: 700;
}

.state-card__description {
  margin-top: 14rpx;
  color: #66716d;
  font-size: 25rpx;
}

.state-card--error {
  border: 1rpx solid rgba(179, 78, 73, 0.16);
}

.sync-indicator {
  position: fixed;
  top: 18rpx;
  right: 24rpx;
  z-index: 30;
  max-width: 430rpx;
  overflow: hidden;
  padding: 9rpx 14rpx;
  border: 1rpx solid #ead9ad;
  border-radius: 8rpx;
  color: #7b641d;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: rgba(250, 245, 231, 0.96);
  box-shadow: 0 4rpx 12rpx rgba(43, 48, 45, 0.08);
}

.quick-actions {
  margin-top: 24rpx;
}

.daily-controls {
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid #d8d3cb;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(38, 47, 43, 0.05);
}

.daily-controls__toggle {
  display: flex;
  min-height: 90rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 15rpx 20rpx;
}

.daily-controls__copy {
  min-width: 0;
  flex: 1;
}

.daily-controls__title {
  color: #2d3b36;
  font-size: 24rpx;
  font-weight: 750;
}

.daily-controls__summary {
  overflow: hidden;
  margin-top: 4rpx;
  color: #76817d;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-controls__state {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 5rpx;
  color: #2e6f68;
  font-size: 21rpx;
  font-weight: 700;
}

.daily-controls__chevron {
  display: inline-block;
  font-size: 24rpx;
  line-height: 1;
  transition: transform 180ms ease;
}

.daily-controls__chevron--open {
  transform: rotate(180deg);
}

.daily-controls__content {
  padding: 18rpx 20rpx 20rpx;
  border-top: 1rpx solid #e7e2db;
  background: #fbfaf7;
}

.daily-controls__content .quick-actions {
  margin-top: 0;
}

.developer-button {
  width: 100%;
  margin: 18rpx 0 0;
  padding: 16rpx 20rpx;
  border: 1rpx dashed #9e968a;
  border-radius: 10rpx;
  color: #6d665d;
  font-size: 22rpx;
  line-height: 1.5;
  background: #eeeae4;
}

.developer-button::after {
  border: 0;
}

.filter-panel {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 14rpx;
  background: #ffffff;
}

.filter-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.filter-picker {
  min-width: 0;
}

.filter-value {
  overflow: hidden;
  padding: 16rpx 10rpx;
  border-radius: 9rpx;
  color: #53605b;
  font-size: 21rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #f3f0eb;
}

.display-mode {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
}

.display-mode__button {
  flex: 1;
  margin: 0;
  padding: 12rpx;
  border: 0;
  border-radius: 8rpx;
  color: #66716d;
  font-size: 22rpx;
  line-height: 1.5;
  background: #f3f0eb;
}

.display-mode__button::after {
  border: 0;
}

.display-mode__button--selected {
  color: #ffffff;
  font-weight: 700;
  background: #2e6f68;
}

.primary-button,
.secondary-button,
.card-button {
  margin: 0;
  border: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.primary-button,
.secondary-button {
  flex: 1;
}

.primary-button,
.card-button--primary {
  color: #ffffff;
  background: #d95c4f;
}

.secondary-button,
.card-button {
  color: #2e6f68;
  background: #e7f0ed;
}

.daily-controls__content .filter-panel {
  margin-top: 18rpx;
}

.primary-button::after,
.secondary-button::after,
.card-button::after {
  border: 0;
}

.primary-button[disabled],
.secondary-button[disabled],
.card-button[disabled],
.developer-button[disabled] {
  opacity: 0.55;
}

.section {
  margin-top: 30rpx;
}

.empty-card {
  color: #66716d;
  font-size: 25rpx;
  text-align: center;
}

.health-card__subject,
.health-card__time,
.health-card__notification,
.field-value,
.health-card__remark {
  color: #66716d;
  font-size: var(--display-body-size);
}

.health-card__meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: #78827e;
  font-size: var(--display-meta-size);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-card__subject {
  min-width: 0;
  margin-top: 7rpx;
  line-height: 1.4;
  overflow-wrap: break-word;
}

.health-card__identity {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 6rpx;
}

.health-card__identity .health-card__title {
  flex: 0 0 auto;
}

.status-badge {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: #8a5b19;
  font-size: 21rpx;
  font-weight: 700;
  background: #f6edda;
}

.status-badge--completed {
  color: #2e6f68;
  background: #e7f0ed;
}

.health-card__notification {
  min-width: 0;
  flex: 1;
  color: #7c8581;
  line-height: 1.55;
}

.field-list {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
}

.field-list--record {
  flex: 1;
  justify-content: flex-start;
}

.field-value--strong {
  color: #202825;
  font-size: var(--display-card-title-size);
  font-weight: 750;
}

.health-card__remark {
  overflow: hidden;
  margin-top: 9rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #e5e0d8;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-card__compact-row,
.record-compact-row,
.linked-record__main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.health-card__compact-row {
  margin-top: 9rpx;
  min-height: 70rpx;
}

.record-compact-row .health-card__identity {
  max-width: 230rpx;
}

.record-card__details .health-card__time,
.linked-record__time {
  flex: 0 0 auto;
  color: #7c8581;
  font-size: 21rpx;
  white-space: nowrap;
}

.record-card__details {
  display: grid;
  gap: 2rpx;
  margin-top: 6rpx;
}

.record-card__details .health-card__subject {
  margin-top: 0;
}

.record-compact-row__open,
.linked-record__open {
  flex: 0 0 auto;
  color: #d95c4f;
  font-size: 24rpx;
  font-weight: 700;
}

.card-actions {
  flex: 0 0 auto;
  justify-content: flex-start;
  gap: 8rpx;
  margin-top: 0;
}

.reminder-card .card-actions {
  width: 74rpx;
  min-width: 74rpx;
}

.card-button {
  width: 74rpx;
  min-width: 74rpx;
  height: 70rpx;
  padding: 0;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 70rpx;
}

.linked-record {
  margin-top: 10rpx;
  padding: 11rpx 13rpx;
  border: 1rpx solid #d8e4ec;
  border-radius: 9rpx;
  background: #eef3f7;
}

.linked-record__label {
  flex: 0 0 auto;
  color: #3f6784;
  font-size: 21rpx;
  font-weight: 700;
}

.linked-record__main .field-list {
  flex: 1;
}

.rule-section {
  padding-top: 8rpx;
  border-top: 1rpx solid #d8d3cb;
}

.rule-card {
  border-color: #d5e2de;
}

.rule-status {
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  color: #2e6f68;
  font-size: 21rpx;
  font-weight: 700;
  background: #e7f0ed;
}

.rule-status--paused {
  color: #8a5b19;
  background: #f6edda;
}

.rule-card__schedule,
.rule-card__range {
  margin-top: 11rpx;
  color: #44514c;
  font-size: 24rpx;
}

.rule-card__range {
  margin-top: 8rpx;
  color: #7c8581;
  font-size: 21rpx;
}
