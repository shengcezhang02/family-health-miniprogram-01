.care-share-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 54rpx 32rpx 90rpx;
  background: #f6f3ee;
}

.care-share-shell--warm-green {
  background: linear-gradient(180deg, #dfeee8 0, #f6f3ee 46%);
}

.care-share-shell--sunset {
  background: linear-gradient(180deg, #f2dfd7 0, #f6f3ee 46%);
}

.care-share-shell--clear-blue {
  background: linear-gradient(180deg, #dce9ef 0, #f6f3ee 46%);
}

.care-card,
.form-card,
.state-card {
  padding: 30rpx;
  border: 1rpx solid #e1dbd2;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 34rpx rgba(40, 53, 48, 0.08);
}

.care-card__eyebrow {
  color: #2e6f68;
  font-size: 22rpx;
  font-weight: 700;
}

.care-card__title,
.state-card__title {
  margin-top: 12rpx;
  color: #202825;
  font-size: 38rpx;
  font-weight: 760;
}

.care-card__message {
  margin-top: 20rpx;
  color: #37443f;
  font-size: 28rpx;
  line-height: 1.65;
}

.care-card__meta,
.state-card__description {
  margin-top: 18rpx;
  color: #6b7672;
  font-size: 23rpx;
  line-height: 1.6;
}

.form-card {
  margin-top: 24rpx;
}

.field-group + .field-group {
  margin-top: 26rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #5e6965;
  font-size: 23rpx;
  font-weight: 650;
}

.input-with-unit {
  position: relative;
}

.field-input,
.picker-value,
.remark-input {
  width: 100%;
  min-height: 84rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d6d0c7;
  border-radius: 10rpx;
  color: #202825;
  font-size: 28rpx;
  background: #fbfaf8;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #2e6f68;
}

.field-unit {
  position: absolute;
  top: 24rpx;
  right: 22rpx;
  color: #6d7773;
  font-size: 24rpx;
}

.feedback {
  margin-top: 22rpx;
  color: #a94f48;
  font-size: 24rpx;
  text-align: center;
}

.primary-button,
.secondary-button {
  margin-top: 26rpx;
  border: 0;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  color: #fff;
  background: #2e6f68;
}

.secondary-button {
  color: #2e6f68;
  background: #e4eeea;
}

.state-card {
  margin-top: 90rpx;
  text-align: center;
}
