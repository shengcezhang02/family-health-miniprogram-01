<view class="share-editor-shell">
  <view class="page-header">
    <view class="page-header__eyebrow">{{familyName}}</view>
    <view class="page-header__title">关心分享</view>
    <view class="page-header__description">
      {{reminderId ? "把这条待完成提醒发给家人填写，不会创建重复提醒。" : "发起一项现在就能填写的健康请求。"}}
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    正在准备分享内容…
  </view>
  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view>{{errorMessage}}</view>
    <button class="secondary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:else>
    <view class="form-card">
      <view class="form-card__title">分享内容</view>
      <view class="field-group">
        <view class="field-label">档案所属人</view>
        <picker
          range="{{members}}"
          range-key="displayLabel"
          value="{{selectedMemberIndex}}"
          disabled="{{reminderId || creating}}"
          bindchange="onMemberChange"
        >
          <view class="picker-value">
            <text>{{selectedMember.displayLabel || "请选择"}}</text>
            <text wx:if="{{!reminderId}}" class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>
      <view class="field-group">
        <view class="field-label">健康项目</view>
        <picker
          range="{{templates}}"
          range-key="name"
          value="{{selectedTemplateIndex}}"
          disabled="{{reminderId || creating}}"
          bindchange="onTemplateChange"
        >
          <view class="picker-value">
            <text>{{selectedTemplate.name || "请选择"}}</text>
            <text wx:if="{{!reminderId}}" class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>
      <view class="field-group">
        <view class="field-label">提醒内容（选填）</view>
        <textarea
          class="remark-input"
          value="{{remark}}"
          maxlength="200"
          auto-height
          disabled="{{reminderId || creating}}"
          placeholder="例如：睡前量一下，填好我就能看到"
          bindinput="onRemarkInput"
        />
      </view>
    </view>

    <view class="form-card">
      <view class="form-card__title">卡片样式</view>
      <view class="style-options">
        <button
          wx:for="{{cardStyles}}"
          wx:key="code"
          class="style-option style-option--{{item.code}} {{cardStyleCode === item.code ? 'style-option--selected' : ''}}"
          data-style-code="{{item.code}}"
          disabled="{{creating}}"
          bindtap="onChooseStyle"
        >
          <view class="style-option__name">{{item.name}}</view>
          <view class="style-option__description">{{item.description}}</view>
        </button>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="feedback">{{errorMessage}}</view>
    <button
      wx:if="{{!share}}"
      id="care-share-create-button"
      class="primary-button"
      loading="{{creating}}"
      disabled="{{creating}}"
      bindtap="onCreateShare"
    >
      生成分享卡
    </button>
    <view wx:else class="share-ready-card">
      <view class="share-ready-card__title">分享卡已准备好</view>
      <view class="share-ready-card__description">
        有效期至 {{share.expiresAt}}，可以多次发送；提醒仍只会成功打卡一次。
      </view>
      <button
        id="care-share-preview-button"
        class="secondary-button"
        bindtap="onPreviewShare"
      >
        先预览填写页
      </button>
      <button
        id="care-share-send-button"
        class="primary-button"
        open-type="share"
      >
        发送给家人
      </button>
    </view>
  </view>
</view>
