<view class="records-shell">
  <view class="records-header">
    <view class="records-header__eyebrow">{{familyName}}</view>
    <view class="records-header__title">已删除记录</view>
    <view class="records-header__description">
      这里仅用于恢复误删的健康记录。
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    <view class="state-card__title">正在读取已删除记录</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view class="state-card__title">暂时无法打开</view>
    <view class="state-card__description">{{errorMessage}}</view>
    <button class="secondary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{items.length === 0}}" class="empty-state">
    <view class="empty-state__icon">✓</view>
    <view class="empty-state__title">没有已删除记录</view>
  </view>

  <view wx:else class="deleted-list">
    <view wx:for="{{items}}" wx:key="id" class="deleted-card">
      <view>
        <view class="deleted-card__title">{{item.templateNameSnapshot}}</view>
        <view class="deleted-card__meta">
          发生于 {{item.displayOccurredAt}}
        </view>
        <view class="deleted-card__meta">
          删除于 {{item.displayDeletedAt}}
        </view>
      </view>
      <button
        id="record-restore-{{item.id}}"
        class="restore-button"
        loading="{{restoringId === item.id}}"
        disabled="{{!!restoringId}}"
        data-record-id="{{item.id}}"
        bindtap="onRestore"
      >
        恢复
      </button>
    </view>
  </view>

  <view wx:if="{{errorMessage && status === 'ready'}}" class="feedback">
    {{errorMessage}}
  </view>
</view>
