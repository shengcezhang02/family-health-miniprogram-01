<view class="management-shell">
  <view class="page-header">
    <view class="page-header__eyebrow">FAMILY · MANAGEMENT</view>
    <view class="page-header__title">家庭管理</view>
    <view class="page-header__description">
      角色变化和退出都由云端再次校验，家庭始终至少保留一名管理员。
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    正在读取家庭成员…
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view>{{errorMessage}}</view>
    <button class="secondary-button" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
    <view class="family-summary">
      <view>
        <view class="family-summary__label">当前家庭</view>
        <view class="family-summary__name">{{familyName}}</view>
      </view>
      <view class="role-badge">
        {{family.role === "admin" ? "管理员" : "家庭成员"}}
      </view>
    </view>

    <view wx:if="{{notice}}" class="feedback feedback--success">
      {{notice}}
    </view>
    <view wx:if="{{errorMessage}}" class="feedback">
      {{errorMessage}}
    </view>

    <view class="section">
      <view class="section__header">
        <view>
          <view class="section__eyebrow">MEMBERS</view>
          <view class="section__title">家庭成员</view>
        </view>
        <button
          wx:if="{{canInvite}}"
          class="small-button"
          bindtap="onInviteFamily"
        >
          邀请成员
        </button>
      </view>

      <button
        wx:for="{{members}}"
        wx:key="id"
        class="member-row"
        data-user-id="{{item.id}}"
        bindtap="onOpenMember"
      >
        <view class="member-row__avatar">
          {{item.avatarText}}
        </view>
        <view class="member-row__body">
          <view class="member-row__name">
            {{item.displayName}}{{item.isSelf ? "（我）" : ""}}
          </view>
          <view class="member-row__meta">
            {{item.role === "admin" ? "管理员" : "普通成员"}}
          </view>
        </view>
        <view class="member-row__arrow">›</view>
      </button>
    </view>

    <view class="section">
      <view class="section__eyebrow">MY ROLE</view>
      <view class="section__title">我的成员关系</view>

      <button
        wx:if="{{canDemoteSelf}}"
        class="secondary-button"
        disabled="{{processing}}"
        bindtap="onDemoteSelf"
      >
        降级为普通成员
      </button>

      <view
        wx:if="{{family.role === 'admin' && !canDemoteSelf}}"
        class="rule-note"
      >
        你是当前唯一管理员，不能直接降级自己。
      </view>

      <button
        wx:if="{{canLeaveDirectly}}"
        class="danger-button danger-button--outline"
        disabled="{{processing}}"
        bindtap="onLeaveFamily"
      >
        退出家庭
      </button>

      <view wx:if="{{mustTransferBeforeLeaving}}" class="transfer-panel">
        <view class="transfer-panel__title">转让管理员后退出</view>
        <view class="transfer-panel__description">
          转让和退出会作为同一个云端操作完成。
        </view>
        <picker
          wx:if="{{successorOptions.length > 0}}"
          mode="selector"
          range="{{successorOptions}}"
          range-key="displayName"
          value="{{successorIndex}}"
          bindchange="onSuccessorChange"
        >
          <view class="picker-value">
            <view>
              {{successorOptions[successorIndex].displayName}}
            </view>
            <view>选择接任者⌄</view>
          </view>
        </picker>
        <view wx:else class="rule-note">
          没有其他有效成员可以接任。你可以继续保留家庭，或在下方永久解散。
        </view>
        <button
          wx:if="{{successorOptions.length > 0}}"
          class="danger-button danger-button--outline"
          disabled="{{processing}}"
          bindtap="onTransferAndLeave"
        >
          转让并退出
        </button>
      </view>
    </view>

    <view wx:if="{{canDissolve}}" class="section danger-zone">
      <view class="section__eyebrow section__eyebrow--danger">DANGER ZONE</view>
      <view class="section__title">永久解散家庭</view>
      <view class="danger-zone__description">
        仅用于不再需要的家庭。请输入完整家庭名称以启用解散按钮。
      </view>
      <input
        class="confirmation-input"
        value="{{confirmationName}}"
        placeholder="{{familyName}}"
        bindinput="onConfirmationNameInput"
      />
      <button
        class="danger-button"
        disabled="{{processing || confirmationName !== familyName}}"
        bindtap="onDissolveFamily"
      >
        永久解散家庭
      </button>
    </view>
  </block>
</view>
