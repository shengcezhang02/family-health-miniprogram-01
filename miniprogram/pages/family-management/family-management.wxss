.management-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 46rpx 34rpx calc(80rpx + env(safe-area-inset-bottom));
  background: #f6f3ee;
}

.page-header__eyebrow,
.section__eyebrow,
.family-summary__label {
  color: #d95c4f;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.page-header__title {
  margin-top: 14rpx;
  color: #202825;
  font-size: 50rpx;
  font-weight: 760;
}

.page-header__description {
  margin-top: 12rpx;
  color: #66716d;
  font-size: 24rpx;
  line-height: 1.6;
}

.state-card,
.family-summary,
.section {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 14rpx;
  background: #ffffff;
}

.state-card {
  color: #66716d;
  font-size: 25rpx;
  text-align: center;
}

.state-card--error {
  color: #a14743;
}

.family-summary,
.section__header,
.member-row,
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.family-summary__name {
  margin-top: 6rpx;
  color: #202825;
  font-size: 33rpx;
  font-weight: 750;
}

.role-badge {
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  color: #2e6f68;
  font-size: 21rpx;
  font-weight: 700;
  background: #e7f0ed;
}

.section__title {
  margin-top: 6rpx;
  color: #202825;
  font-size: 31rpx;
  font-weight: 730;
}

.small-button {
  flex: 0 0 auto;
  margin: 0;
  padding: 8rpx 18rpx;
  border: 0;
  border-radius: 9rpx;
  color: #ffffff;
  font-size: 22rpx;
  background: #2e6f68;
}

.member-row {
  width: 100%;
  margin: 18rpx 0 0;
  padding: 18rpx 0;
  border: 0;
  border-top: 1rpx solid #ece7df;
  color: #202825;
  line-height: 1.4;
  text-align: left;
  background: transparent;
}

.member-row__avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  background: #4f7fa3;
}

.member-row__body {
  min-width: 0;
  flex: 1;
}

.member-row__name {
  font-size: 27rpx;
  font-weight: 700;
}

.member-row__meta {
  margin-top: 3rpx;
  color: #7c8581;
  font-size: 21rpx;
}

.member-row__arrow {
  color: #d95c4f;
  font-size: 34rpx;
}

.secondary-button,
.danger-button {
  width: 100%;
  margin: 20rpx 0 0;
  border: 0;
  border-radius: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.secondary-button {
  color: #2e6f68;
  background: #e7f0ed;
}

.danger-button {
  color: #ffffff;
  background: #b34e49;
}

.danger-button--outline {
  color: #a14743;
  border: 1rpx solid #d8aaa6;
  background: #ffffff;
}

.rule-note,
.transfer-panel__description,
.danger-zone__description {
  margin-top: 16rpx;
  color: #6f7975;
  font-size: 22rpx;
  line-height: 1.55;
}

.transfer-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e6e0d8;
}

.transfer-panel__title {
  color: #202825;
  font-size: 26rpx;
  font-weight: 700;
}

.picker-value {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #d8d3cb;
  border-radius: 10rpx;
  color: #3e4b46;
  font-size: 24rpx;
  background: #f7f5f1;
}

.danger-zone {
  border-color: #e2c2bf;
}

.section__eyebrow--danger {
  color: #a14743;
}

.confirmation-input {
  height: 82rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8aaa6;
  border-radius: 10rpx;
  color: #202825;
  font-size: 25rpx;
  background: #ffffff;
}

.feedback {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e6c1be;
  border-radius: 9rpx;
  color: #a14743;
  font-size: 22rpx;
  background: #faeceb;
}

.feedback--success {
  color: #2e6f68;
  border-color: #c7ddd5;
  background: #e7f0ed;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.48;
}
