.template-shell {
  min-height: 100vh;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
  padding: 48rpx 36rpx 72rpx;
  background:
    radial-gradient(circle at 90% 4%, rgba(105, 185, 151, 0.18), transparent 28%),
    #f4f7f5;
}

.template-header__eyebrow {
  color: #2f765e;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.template-header__row,
.template-card__top,
.field-card__top,
.switch-row,
.option-row,
.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.template-header__row {
  margin-top: 16rpx;
}

.template-header__title {
  color: #12392c;
  font-size: 50rpx;
  font-weight: 760;
}

.template-header__description {
  margin-top: 10rpx;
  color: #70857d;
  font-size: 24rpx;
  line-height: 1.55;
}

.add-button,
.small-add-button {
  flex: 0 0 auto;
  margin: 0;
  border: 0;
  color: #ffffff;
  font-weight: 700;
  background: #2f765e;
}

.add-button {
  padding: 0 24rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.small-add-button {
  margin-top: 18rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
}

.state-card,
.empty-state,
.template-card,
.template-form {
  margin-top: 34rpx;
  padding: 32rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 36rpx rgba(45, 86, 69, 0.07);
}

.state-card,
.empty-state {
  margin-top: 60rpx;
  text-align: center;
}

.state-card__title,
.empty-state__title {
  color: #244c3e;
  font-size: 30rpx;
  font-weight: 700;
}

.state-card__description,
.empty-state__description {
  margin-top: 14rpx;
  color: #70857d;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f4f8f6;
}

.field-card__title,
.template-card__title {
  color: #244c3e;
  font-size: 29rpx;
  font-weight: 700;
}

.field-label {
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  color: #45655a;
  font-size: 24rpx;
  font-weight: 700;
}

.field-label--spaced {
  margin-top: 24rpx;
}

.color-picker {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.color-option {
  display: flex;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  height: 70rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 2rpx solid #dde7e2;
  border-radius: 14rpx;
  color: #49635a;
  font-size: 22rpx;
  background: #ffffff;
}

.custom-color-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.custom-color-preview {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8e3dd;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f0ece6, #ffffff);
}

.color-code-input {
  min-width: 0;
  height: 68rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 2rpx solid #dce8e2;
  border-radius: 14rpx;
  color: #173b2f;
  font-size: 25rpx;
  background: #ffffff;
}

.color-code-hint {
  margin-top: 9rpx;
  color: #7d8d86;
  font-size: 21rpx;
  line-height: 1.45;
}

.color-option--selected {
  border-color: #2f765e;
  color: #173b2f;
  box-shadow: 0 0 0 3rpx rgba(47, 118, 94, 0.1);
}

.color-option__swatch,
.template-card__color {
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #75658c;
}

.color-option--rose .color-option__swatch,
.template-card__color--rose { background: #b65d66; }
.color-option--blue .color-option__swatch,
.template-card__color--blue { background: #4d7598; }
.color-option--green .color-option__swatch,
.template-card__color--green { background: #4f8067; }
.color-option--amber .color-option__swatch,
.template-card__color--amber { background: #a87832; }
.color-option--purple .color-option__swatch,
.template-card__color--purple { background: #75658c; }
.color-option--teal .color-option__swatch,
.template-card__color--teal { background: #347a77; }

.standalone-input,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  border: 2rpx solid #dce8e2;
  border-radius: 18rpx;
  color: #173b2f;
  font-size: 27rpx;
  background: #ffffff;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.locked-type-value {
  display: flex;
  min-height: 82rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  border: 2rpx solid #e1e7e4;
  border-radius: 18rpx;
  color: #60776f;
  font-size: 27rpx;
  background: #eef2f0;
}

.locked-type-value__badge {
  padding: 6rpx 13rpx;
  border-radius: 999rpx;
  color: #71827b;
  font-size: 20rpx;
  background: #dde5e1;
}

.lock-hint {
  margin-top: 10rpx;
  color: #7d8d86;
  font-size: 21rpx;
  line-height: 1.55;
}

.switch-row {
  margin-top: 22rpx;
  color: #45655a;
  font-size: 24rpx;
}

.options-panel {
  margin-top: 24rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid #dce8e2;
}

.option-row {
  margin-top: 14rpx;
}

.option-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 18rpx;
  border: 2rpx solid #dce8e2;
  border-radius: 16rpx;
  background: #ffffff;
}

.small-danger-button {
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  border: 0;
  color: #a14743;
  font-size: 22rpx;
  background: transparent;
}

.template-list {
  margin-top: 30rpx;
}

.template-card {
  border: 1rpx solid #e2ebe6;
}

.template-card__identity {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 16rpx;
}

.template-card__color {
  width: 14rpx;
  height: 44rpx;
  margin-top: 2rpx;
  border-radius: 7rpx;
}

.template-card__meta,
.template-card__fields {
  margin-top: 9rpx;
  color: #70857d;
  font-size: 23rpx;
  line-height: 1.6;
}

.status-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
}

.status-badge--active {
  color: #2f765e;
  background: #e3f0ea;
}

.status-badge--inactive {
  color: #7d8883;
  background: #edf0ee;
}

.card-actions {
  justify-content: flex-start;
  margin-top: 22rpx;
}

.card-button {
  margin: 0;
  border: 0;
  border-radius: 15rpx;
  color: #ffffff;
  font-size: 23rpx;
  background: #2f765e;
}

.card-button--quiet {
  color: #2f765e;
  background: #e3f0ea;
}

.primary-button,
.secondary-button,
.text-button {
  margin-top: 26rpx;
  border: 0;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #2f765e;
}

.secondary-button {
  color: #2f765e;
  background: #e3f0ea;
}

.text-button {
  color: #60776f;
  background: transparent;
}

.feedback {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  color: #a14743;
  font-size: 23rpx;
  background: #faeceb;
}

button::after {
  border: 0;
}
