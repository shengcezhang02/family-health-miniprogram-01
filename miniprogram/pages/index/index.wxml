<view class="page-shell">
  <view class="brand">
    <view class="brand__mark">家</view>
    <view>
      <view class="brand__title">家庭健康</view>
      <view class="brand__subtitle">把家人的健康事项放在一起</view>
    </view>
  </view>

  <view class="hero">
    <view class="hero__eyebrow">家庭健康空间</view>
    <view class="hero__title">记录、提醒与陪伴，都更清楚一点</view>
    <view class="hero__description">
      共同记录家人的健康数据，安排提醒，并在明确授权后代管健康档案。
    </view>
  </view>

  <view class="status-card status-card--{{status}}">
    <view class="status-card__indicator"></view>
    <view class="status-card__content">
      <view class="status-card__title">
        {{status === "loading" ? "正在准备" : status === "ready" ? "环境已就绪" : "连接遇到问题"}}
      </view>
      <view class="status-card__message">{{message}}</view>
    </view>
  </view>

  <button
    wx:if="{{status === 'error'}}"
    class="retry-button"
    bindtap="onRetry"
    hover-class="retry-button--pressed"
  >
    重新加载
  </button>

  <view wx:if="{{status === 'ready'}}" class="next-step">
    下一步：创建第一个家庭
  </view>

  <view class="privacy-note">健康数据将通过云端权限校验，不直接保存在本机。</view>
</view>
