<view class="page-shell">
  <view class="brand">
    <view class="brand__mark">家</view>
    <view>
      <view class="brand__title">家庭健康</view>
      <view class="brand__subtitle">把家人的健康事项放在一起</view>
    </view>
  </view>

  <view wx:if="{{status !== 'ready'}}" class="connection-panel">
    <view class="hero">
      <view class="hero__eyebrow">家庭健康空间</view>
      <view class="hero__title">记录、提醒与陪伴，都更清楚一点</view>
      <view class="hero__description">
        共同记录家人的健康数据，安排提醒，并在明确授权后代管健康档案。
      </view>
    </view>

    <view class="status-card status-card--{{status}}">
      <view class="status-card__indicator"></view>
      <view class="status-card__content">
        <view id="status-title" class="status-card__title">
          {{status === "loading" ? "正在准备" : "连接遇到问题"}}
        </view>
        <view class="status-card__message">{{message}}</view>
      </view>
    </view>

    <button
      wx:if="{{status === 'error'}}"
      class="primary-button"
      bindtap="onRetry"
      hover-class="button--pressed"
    >
      重新加载
    </button>
  </view>

  <view wx:elif="{{!currentFamily}}" class="onboarding">
    <view class="onboarding__eyebrow">环境已就绪</view>
    <view class="onboarding__title">先建立一个健康空间</view>
    <view class="onboarding__description">
      家庭空间适合和家人一起使用；个人空间适合先从自己的健康记录开始。
    </view>

    <view wx:if="{{!showFamilyForm}}" class="choice-list">
      <button
        id="choose-family-button"
        class="choice-card"
        bindtap="onShowFamilyForm"
        hover-class="choice-card--pressed"
      >
        <view class="choice-card__icon">家</view>
        <view class="choice-card__body">
          <view class="choice-card__title">创建家庭</view>
          <view class="choice-card__description">邀请家人一起记录和提醒</view>
        </view>
        <view class="choice-card__arrow">›</view>
      </button>

      <button
        id="create-personal-button"
        class="choice-card choice-card--quiet"
        loading="{{creating}}"
        disabled="{{creating}}"
        bindtap="onCreatePersonalSpace"
        hover-class="choice-card--pressed"
      >
        <view class="choice-card__icon choice-card__icon--quiet">我</view>
        <view class="choice-card__body">
          <view class="choice-card__title">创建个人空间</view>
          <view class="choice-card__description">先管理自己的健康事项</view>
        </view>
        <view class="choice-card__arrow">›</view>
      </button>

      <button
        id="join-family-button"
        class="choice-card choice-card--quiet"
        bindtap="onJoinFamily"
        hover-class="choice-card--pressed"
      >
        <view class="choice-card__icon choice-card__icon--quiet">码</view>
        <view class="choice-card__body">
          <view class="choice-card__title">输入邀请码</view>
          <view class="choice-card__description">加入家人已经建立的空间</view>
        </view>
        <view class="choice-card__arrow">›</view>
      </button>
    </view>

    <view wx:else class="family-form">
      <view class="family-form__label">家庭名称</view>
      <input
        id="family-name-input"
        class="family-form__input"
        value="{{familyName}}"
        maxlength="40"
        placeholder="例如：我们家"
        focus
        bindinput="onFamilyNameInput"
      />
      <view wx:if="{{formError}}" class="form-error">{{formError}}</view>
      <button
        id="submit-family-button"
        class="primary-button"
        loading="{{creating}}"
        disabled="{{creating}}"
        bindtap="onCreateFamily"
        hover-class="button--pressed"
      >
        建立家庭空间
      </button>
      <button
        class="text-button"
        disabled="{{creating}}"
        bindtap="onHideFamilyForm"
      >
        返回选择
      </button>
    </view>
  </view>

  <view wx:else class="family-home">
    <view class="family-home__eyebrow">当前家庭</view>
    <view id="current-family-name" class="family-home__title">
      {{currentFamily.name}}
    </view>
    <view class="role-badge">
      {{currentFamily.role === "admin" ? "管理员" : "家庭成员"}}
    </view>

    <view class="empty-card">
      <view class="empty-card__icon">档</view>
      <view class="empty-card__title">维护家人的健康档案</view>
      <view class="empty-card__description">
        记录当前糖尿病和高血压情况。本人可以随时修改，也可以明确允许家人代管。
      </view>
      <button
        id="open-profiles-button"
        class="primary-button"
        bindtap="onOpenProfiles"
      >
        打开健康档案
      </button>
    </view>

    <view class="family-actions">
      <button
        wx:if="{{currentFamily.role === 'admin'}}"
        id="invite-family-button"
        class="family-action family-action--primary"
        bindtap="onInviteFamily"
      >
        邀请家人
      </button>
      <button
        id="join-another-family-button"
        class="family-action"
        bindtap="onJoinFamily"
      >
        输入邀请码
      </button>
      <button
        wx:if="{{families.length > 1}}"
        id="switch-family-button"
        class="family-action"
        bindtap="onToggleFamilySwitcher"
      >
        切换家庭
      </button>
    </view>

    <view wx:if="{{showFamilySwitcher}}" class="family-switcher">
      <button
        wx:for="{{families}}"
        wx:key="id"
        class="family-switcher__item"
        data-family-id="{{item.id}}"
        bindtap="onSelectFamily"
      >
        <view>{{item.name}}</view>
        <view class="family-switcher__role">
          {{item.role === "admin" ? "管理员" : "成员"}}
        </view>
      </button>
    </view>
  </view>

  <view class="privacy-note">健康数据通过云端权限校验，本机只保存当前家庭的编号。</view>
</view>
