.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 40rpx 44rpx;
  background:
    radial-gradient(circle at 88% 8%, rgba(105, 185, 151, 0.24), transparent 30%),
    linear-gradient(180deg, #f7faf8 0%, #edf4f0 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand__mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  background: #2f765e;
  box-shadow: 0 14rpx 30rpx rgba(47, 118, 94, 0.18);
}

.brand__title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand__subtitle {
  margin-top: 4rpx;
  color: #688278;
  font-size: 24rpx;
}

.hero {
  margin-top: 92rpx;
}

.hero__eyebrow {
  color: #2f765e;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero__title {
  max-width: 620rpx;
  margin-top: 20rpx;
  color: #12392c;
  font-size: 58rpx;
  font-weight: 760;
  line-height: 1.24;
}

.hero__description {
  max-width: 620rpx;
  margin-top: 28rpx;
  color: #60776f;
  font-size: 28rpx;
  line-height: 1.75;
}

.status-card {
  display: flex;
  gap: 22rpx;
  margin-top: 72rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(47, 118, 94, 0.11);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 18rpx 54rpx rgba(45, 86, 69, 0.09);
}

.status-card__indicator {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 auto;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d9a441;
  box-shadow: 0 0 0 10rpx rgba(217, 164, 65, 0.14);
}

.status-card--ready .status-card__indicator {
  background: #3f9b76;
  box-shadow: 0 0 0 10rpx rgba(63, 155, 118, 0.14);
}

.status-card--error .status-card__indicator {
  background: #c65e59;
  box-shadow: 0 0 0 10rpx rgba(198, 94, 89, 0.14);
}

.status-card__content {
  flex: 1;
}

.status-card__title {
  color: #244c3e;
  font-size: 30rpx;
  font-weight: 700;
}

.status-card__message {
  margin-top: 10rpx;
  color: #70857d;
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  background: #2f765e;
}

.retry-button::after {
  border: 0;
}

.retry-button--pressed {
  opacity: 0.86;
}

.next-step {
  margin-top: 30rpx;
  color: #2f765e;
  font-size: 26rpx;
  font-weight: 650;
  text-align: center;
}

.privacy-note {
  margin-top: 80rpx;
  color: #8a9b95;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
