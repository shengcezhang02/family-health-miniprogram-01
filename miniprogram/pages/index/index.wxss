.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 36rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f6f3ee;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand__mark {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  background: #d95c4f;
}

.brand__title {
  color: #202825;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand__subtitle {
  margin-top: 4rpx;
  color: #66716d;
  font-size: 24rpx;
}

.hero {
  margin-top: 92rpx;
}

.hero__eyebrow,
.onboarding__eyebrow,
.family-home__eyebrow {
  color: #d95c4f;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero__title {
  max-width: 620rpx;
  margin-top: 20rpx;
  color: #12392c;
  font-size: 58rpx;
  font-weight: 760;
  line-height: 1.24;
}

.hero__description,
.onboarding__description {
  max-width: 620rpx;
  margin-top: 28rpx;
  color: #60776f;
  font-size: 28rpx;
  line-height: 1.75;
}

.status-card {
  display: flex;
  gap: 22rpx;
  margin-top: 72rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(47, 118, 94, 0.11);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 18rpx 54rpx rgba(45, 86, 69, 0.09);
}

.status-card__indicator {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 auto;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d9a441;
  box-shadow: 0 0 0 10rpx rgba(217, 164, 65, 0.14);
}

.status-card--error .status-card__indicator {
  background: #c65e59;
  box-shadow: 0 0 0 10rpx rgba(198, 94, 89, 0.14);
}

.status-card__content {
  flex: 1;
}

.status-card__title {
  color: #244c3e;
  font-size: 30rpx;
  font-weight: 700;
}

.status-card__message {
  margin-top: 10rpx;
  color: #70857d;
  font-size: 25rpx;
  line-height: 1.6;
}

.onboarding,
.family-home {
  margin-top: 92rpx;
}

.onboarding__title,
.family-home__title {
  margin-top: 20rpx;
  color: #202825;
  font-size: 52rpx;
  font-weight: 750;
  line-height: 1.28;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 56rpx;
}

.choice-card {
  display: flex;
  min-height: 154rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border: 0;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  color: #202825;
  text-align: left;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(37, 45, 41, 0.05);
}

.choice-list .choice-card {
  width: 100%;
  margin-right: 0;
  margin-left: 0;
}

.choice-card::after,
.primary-button::after,
.text-button::after {
  border: 0;
}

.choice-card--quiet {
  background: rgba(255, 255, 255, 0.62);
  box-shadow: none;
}

.choice-card--pressed,
.button--pressed {
  opacity: 0.82;
}

.choice-card__icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  background: #2e6f68;
}

.choice-card__icon--quiet {
  color: #4d6f8d;
  background: #e8eef3;
}

.choice-card__body {
  flex: 1;
}

.choice-card__title {
  font-size: 31rpx;
  font-weight: 700;
}

.choice-card__description {
  margin-top: 6rpx;
  color: #66716d;
  font-size: 24rpx;
  line-height: 1.5;
}

.choice-card__arrow {
  color: #8da098;
  font-size: 48rpx;
  font-weight: 300;
}

.family-form {
  margin-top: 56rpx;
  padding: 34rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  background: #ffffff;
}

.family-form__label {
  color: #244c3e;
  font-size: 27rpx;
  font-weight: 700;
}

.family-form__input {
  height: 92rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dbe8e2;
  border-radius: 12rpx;
  color: #202825;
  font-size: 30rpx;
  background: #ffffff;
}

.form-error {
  margin-top: 14rpx;
  color: #b34e49;
  font-size: 24rpx;
}

.primary-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  background: #d95c4f;
}

.text-button {
  margin-top: 14rpx;
  border: 0;
  color: #60776f;
  font-size: 26rpx;
  background: transparent;
}

.role-badge {
  display: inline-flex;
  margin-top: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #2e6f68;
  font-size: 24rpx;
  font-weight: 700;
  background: #e7f0ed;
}

.empty-card {
  margin-top: 28rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  text-align: center;
  background: #ffffff;
}

.empty-card--records {
  margin-top: 28rpx;
}

.empty-card--records + .empty-card {
  margin-top: 28rpx;
}

.empty-card__icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #4d6f8d;
  font-size: 46rpx;
  background: #e8eef3;
}

.empty-card__title {
  margin-top: 28rpx;
  color: #202825;
  font-size: 31rpx;
  font-weight: 700;
}

.empty-card__description {
  margin-top: 14rpx;
  color: #66716d;
  font-size: 25rpx;
  line-height: 1.65;
}

.family-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.family-action {
  flex: 1;
  border: 0;
  border: 1rpx solid #d8d3cb;
  border-radius: 12rpx;
  color: #3e4b46;
  font-size: 25rpx;
  font-weight: 700;
  background: #ffffff;
}

.family-action::after,
.family-switcher__item::after {
  border: 0;
}

.family-action--primary {
  color: #ffffff;
  border-color: #2e6f68;
  background: #2e6f68;
}

.family-switcher {
  margin-top: 20rpx;
  padding: 16rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 14rpx;
  background: #ffffff;
}

.family-switcher__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 0;
  color: #202825;
  font-size: 27rpx;
  text-align: left;
  background: transparent;
}

.family-switcher__role {
  color: #7c8581;
  font-size: 23rpx;
}

.privacy-note {
  margin-top: 80rpx;
  color: #8a9b95;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
.family-home__description {
  margin-top: 10rpx;
  color: #66716d;
  font-size: var(--display-body-size);
  line-height: 1.55;
}

.current-space {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 34rpx;
  padding: var(--display-card-padding);
  border: 1rpx solid #d8d3cb;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(37, 45, 41, 0.05);
}

.current-space__label {
  color: #4d6f8d;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.current-space__name {
  margin-top: 7rpx;
  color: #202825;
  font-size: var(--display-card-title-size);
  font-weight: 750;
}

.manage-family-button {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 16rpx 0 0;
  padding: var(--display-row-padding) var(--display-card-padding);
  border: 1rpx solid #d8d3cb;
  border-radius: 12rpx;
  color: #202825;
  text-align: left;
  background: #ffffff;
}

.manage-family-button__title {
  font-size: var(--display-body-size);
  font-weight: 700;
}

.manage-family-button__description {
  margin-top: 4rpx;
  color: #66716d;
  font-size: var(--display-meta-size);
}

.manage-family-button__arrow {
  color: #d95c4f;
  font-size: 36rpx;
}

.manage-family-button::after {
  border: 0;
}

.section-label {
  margin-top: 30rpx;
  color: #6f7a75;
  font-size: var(--display-meta-size);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.connection-setting {
  margin-top: 12rpx;
}

.connection-setting__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
  background: linear-gradient(145deg, #4d6f8d, #2e6f68);
}

.connection-setting__body {
  min-width: 0;
  flex: 1;
}

.display-setting {
  margin-top: 28rpx;
  padding: var(--display-card-padding);
  border: 2rpx solid #cfded8;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(37, 45, 41, 0.05);
}

.display-setting__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.display-setting__title {
  color: #202825;
  font-size: var(--display-card-title-size);
  font-weight: 750;
}

.display-setting__description {
  margin-top: 6rpx;
  color: #66716d;
  font-size: var(--display-meta-size);
}

.display-setting__current {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 7rpx;
  color: #ffffff;
  font-size: var(--display-meta-size);
  font-weight: 700;
  background: #2e6f68;
}

.display-setting__options {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.name-setting {
  margin-top: 16rpx;
  padding: var(--display-card-padding);
  border: 1rpx solid #d8d3cb;
  border-radius: 14rpx;
  background: #ffffff;
}

.name-setting__title {
  color: #202825;
  font-size: var(--display-card-title-size);
  font-weight: 750;
}

.name-setting__description {
  margin-top: 5rpx;
  color: #66716d;
  font-size: var(--display-meta-size);
}

.name-setting__form {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.name-setting__input {
  height: 78rpx;
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 2rpx solid #cfded8;
  border-radius: 10rpx;
  color: #202825;
  font-size: var(--display-body-size);
  background: #faf9f6;
}

.name-setting__button {
  width: 132rpx;
  height: 78rpx;
  flex: 0 0 132rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: var(--display-body-size);
  font-weight: 700;
  line-height: 78rpx;
  background: #2e6f68;
}

.name-setting__button::after {
  border: 0;
}

.display-size-option {
  display: flex;
  width: 0;
  min-width: 0;
  min-height: 142rpx;
  flex: 1;
  overflow: hidden;
  box-sizing: border-box;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  margin: 0;
  padding: 14rpx 8rpx;
  border: 2rpx solid #ded8cf;
  border-radius: 11rpx;
  color: #38443f;
  line-height: 1.25;
  background: #faf9f6;
}

.display-size-option::after {
  border: 0;
}

.display-size-option--selected {
  border-color: #2e6f68;
  color: #194f47;
  background: #e8f1ed;
  box-shadow: inset 0 0 0 1rpx rgba(46, 111, 104, 0.18);
}

.display-size-option__sample {
  font-weight: 760;
  line-height: 1;
}

.display-size-option__sample--standard {
  font-size: 25rpx;
}

.display-size-option__sample--large {
  font-size: 31rpx;
}

.display-size-option__sample--extra-large {
  font-size: 37rpx;
}

.display-size-option__label {
  margin-top: 9rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.display-size-option__description {
  margin-top: 3rpx;
  overflow: hidden;
  color: #74807b;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.display-size-option--selected .display-size-option__description {
  color: #52736b;
}
