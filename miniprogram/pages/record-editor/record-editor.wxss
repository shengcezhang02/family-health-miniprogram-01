.editor-shell {
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding: 48rpx 36rpx 72rpx;
  background: #f6f3ee;
}

.editor-sync-indicator {
  position: fixed;
  top: 18rpx;
  right: 24rpx;
  z-index: 30;
  max-width: 430rpx;
  overflow: hidden;
  padding: 9rpx 14rpx;
  border: 1rpx solid #ead9ad;
  border-radius: 8rpx;
  color: #7b641d;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: rgba(250, 245, 231, 0.96);
  box-shadow: 0 4rpx 12rpx rgba(43, 48, 45, 0.08);
}

.form-skeleton {
  margin-top: 28rpx;
}

.form-skeleton__card,
.form-skeleton__button {
  border: 1rpx solid #e2ddd5;
  border-radius: 14rpx;
  background: #ebe7e0;
}

.form-skeleton__card {
  height: 320rpx;
  margin-top: 18rpx;
}

.form-skeleton__card--short {
  height: 180rpx;
}

.form-skeleton__button {
  height: 88rpx;
  margin-top: 24rpx;
}

.editor-header__eyebrow {
  color: #d95c4f;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.editor-header__title {
  margin-top: 16rpx;
  color: #202825;
  font-size: 50rpx;
  font-weight: 760;
}

.editor-header__description {
  margin-top: 12rpx;
  color: #66716d;
  font-size: 25rpx;
  line-height: 1.65;
}

.state-card,
.form-card {
  margin-top: 30rpx;
  padding: 30rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(37, 45, 41, 0.05);
}

.state-card {
  margin-top: 60rpx;
  text-align: center;
}

.state-card__title,
.form-card__title {
  color: #244c3e;
  font-size: 31rpx;
  font-weight: 700;
}

.state-card__description {
  margin-top: 14rpx;
  color: #70857d;
  font-size: 25rpx;
  line-height: 1.65;
}

.state-card--error {
  border: 1rpx solid rgba(179, 78, 73, 0.16);
}

.field-group + .field-group {
  margin-top: 30rpx;
}

.form-card__title + .field-group {
  margin-top: 26rpx;
}

.mode-selector {
  display: flex;
  gap: 12rpx;
}

.mode-selector__button {
  position: relative;
  flex: 1;
  margin: 0;
  padding: 18rpx 8rpx;
  border: 0;
  border-radius: 10rpx;
  color: #60776f;
  font-size: 23rpx;
  background: #eef4f1;
}

.mode-selector__button::after {
  border: 0;
}

.mode-selector__button--selected {
  color: #ffffff;
  font-weight: 700;
  background: #2e6f68;
}

.mode-selector__button--future {
  padding-right: 34rpx;
}

.mode-selector__badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  padding: 2rpx 7rpx;
  border-radius: 999rpx;
  color: #7d6640;
  font-size: 16rpx;
  background: #f6edda;
}

.field-label {
  margin-bottom: 14rpx;
  color: #45655a;
  font-size: 25rpx;
  font-weight: 700;
}

.picker-value,
.date-time-value,
.input-with-unit,
.remark-input {
  box-sizing: border-box;
  border: 1rpx solid #d8d3cb;
  border-radius: 12rpx;
  background: #ffffff;
}

.picker-value {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: #173b2f;
  font-size: 28rpx;
}

.picker-value__arrow {
  color: #81968e;
  font-size: 34rpx;
}

.input-with-unit {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.field-input {
  height: 88rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 0 24rpx;
  color: #173b2f;
  font-size: 29rpx;
}

.field-unit {
  padding-right: 24rpx;
  color: #60776f;
  font-size: 25rpx;
}

.choice-picker {
  width: 100%;
}

.form-hint {
  margin-top: 12rpx;
  color: #70857d;
  font-size: 23rpx;
  line-height: 1.55;
}

.temporary-field {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #f3f0eb;
}

.standalone-input {
  width: 100%;
  margin-top: 14rpx;
  border: 1rpx solid #d8d3cb;
  border-radius: 10rpx;
  background: #ffffff;
}

.small-text-button {
  display: inline-block;
  margin: 12rpx 0 0;
  padding: 0;
  border: 0;
  color: #a14743;
  font-size: 23rpx;
  line-height: 1.8;
  background: transparent;
}

.small-text-button::after {
  border: 0;
}

.date-time-row {
  display: flex;
  gap: 18rpx;
}

.date-time-row picker {
  flex: 1;
}

.date-time-row + .field-group {
  margin-top: 30rpx;
}

.date-time-value {
  padding: 24rpx;
  color: #173b2f;
  font-size: 27rpx;
  text-align: center;
}

.notification-time {
  margin-top: 18rpx;
  padding: 18rpx 20rpx 12rpx;
  border-radius: 12rpx;
  background: #f3f0eb;
}

.weekday-row {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
  overflow: hidden;
}

.weekday-button {
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 12rpx 0;
  border: 0;
  border-radius: 10rpx;
  color: #60776f;
  font-size: 22rpx;
  line-height: 1.5;
  background: #eef4f1;
}

.weekday-button::after {
  border: 0;
}

.weekday-button--selected {
  color: #ffffff;
  font-weight: 700;
  background: #2f765e;
}

.interval-row,
.daily-time-row {
  display: flex;
  align-items: center;
}

.interval-row {
  gap: 16rpx;
  margin-top: 18rpx;
  color: #45655a;
  font-size: 25rpx;
}

.interval-hint {
  margin-top: 10rpx;
  color: #7c8581;
  font-size: 21rpx;
  line-height: 1.5;
}

.interval-input {
  width: 140rpx;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #d8d3cb;
  border-radius: 10rpx;
  color: #173b2f;
  text-align: center;
  background: #fbfdfc;
}

.daily-time-row {
  gap: 18rpx;
  margin-top: 14rpx;
}

.daily-time-row picker {
  flex: 1;
}

.daily-time-remove {
  flex: 0 0 auto;
  margin: 0;
}

.secondary-button--compact {
  margin-top: 18rpx;
  font-size: 25rpx;
}

.remark-input {
  width: 100%;
  min-height: 130rpx;
  padding: 22rpx 24rpx;
  color: #173b2f;
  font-size: 27rpx;
  line-height: 1.6;
}

.reminder-note {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  color: #60776f;
  font-size: 24rpx;
  line-height: 1.6;
  background: #eef5f1;
}

.feedback {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 10rpx;
  color: #a14743;
  font-size: 24rpx;
  line-height: 1.5;
  background: #faeceb;
}

.primary-button,
.secondary-button {
  margin-top: 30rpx;
  border: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #d95c4f;
}

.secondary-button {
  color: #2f765e;
  background: #e3f0ea;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}
