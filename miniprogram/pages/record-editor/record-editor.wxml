<view class="editor-shell">
  <view class="editor-header">
    <view class="editor-header__eyebrow">{{familyName}}</view>
    <view class="editor-header__title">{{pageTitle}}</view>
    <view class="editor-header__description">
      {{pageDescription}}
    </view>
  </view>

  <view
    wx:if="{{syncNotice || status === 'loading'}}"
    class="editor-sync-indicator"
  >
    {{syncNotice || "正在准备表单…"}}
  </view>

  <view wx:if="{{status === 'error'}}" class="state-card state-card--error">
    <view class="state-card__title">暂时无法打开</view>
    <view class="state-card__description">{{errorMessage}}</view>
    <button
      wx:if="{{showGoHome}}"
      class="secondary-button"
      bindtap="onGoHome"
    >
      返回首页
    </button>
    <button
      wx:else
      class="secondary-button"
      bindtap="onRetry"
    >
      重新加载
    </button>
  </view>

  <view wx:elif="{{status === 'loading'}}" class="form-skeleton">
    <view class="form-skeleton__card form-skeleton__card--short"></view>
    <view class="form-skeleton__card"></view>
    <view class="form-skeleton__button"></view>
  </view>

  <view wx:else>
    <view wx:if="{{showModeSelector}}" class="form-card">
      <view class="field-label">事项形式</view>
      <view class="mode-selector">
        <button
          id="health-item-mode-record"
          class="mode-selector__button {{mode === 'record' ? 'mode-selector__button--selected' : ''}}"
          data-mode="record"
          disabled="{{saving || formLocked}}"
          bindtap="onModeSelect"
        >
          记录
        </button>
        <button
          id="health-item-mode-reminder"
          class="mode-selector__button {{mode === 'reminder' ? 'mode-selector__button--selected' : ''}}"
          data-mode="reminder"
          disabled="{{saving || formLocked}}"
          bindtap="onModeSelect"
        >
          一次性提醒
        </button>
        <button
          id="health-item-mode-recurring"
          class="mode-selector__button {{mode === 'recurring' ? 'mode-selector__button--selected' : ''}}"
          data-mode="recurring"
          disabled="{{saving || formLocked}}"
          bindtap="onModeSelect"
        >
          周期提醒
        </button>
      </view>
    </view>

    <view class="form-card">
      <view class="field-group">
        <view class="field-label">
          {{mode === "record" ? "记录谁的健康情况" : "提醒谁"}}
        </view>
        <picker
          id="record-member-picker"
          range="{{members}}"
          range-key="displayLabel"
          value="{{selectedMemberIndex}}"
          disabled="{{saving || formLocked || reminderId || ruleId}}"
          bindchange="onMemberChange"
        >
          <view class="picker-value">
            <view>
              {{selectedMember.displayLabel}}
            </view>
            <view class="picker-value__arrow">⌄</view>
          </view>
        </picker>
      </view>

      <view class="field-group">
        <view class="field-label">健康项目</view>
        <picker
          id="record-template-picker"
          range="{{templates}}"
          range-key="name"
          value="{{selectedTemplateIndex}}"
          disabled="{{saving || formLocked || reminderId || ruleId}}"
          bindchange="onTemplateChange"
        >
          <view class="picker-value">
            <view>{{selectedTemplate.name}}</view>
            <view class="picker-value__arrow">⌄</view>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-card">
      <view class="form-card__title">{{selectedTemplate.name}}</view>
      <view
        wx:for="{{selectedTemplate.fields}}"
        wx:key="key"
        class="field-group"
      >
        <view class="field-label">
          {{item.label}}{{mode === "record" || mode === "checkIn" ? (item.required ? "" : "（选填）") : "（可留到打卡时填写）"}}
        </view>
        <view class="input-with-unit">
          <input
            wx:if="{{item.type === 'number'}}"
            id="record-field-{{item.key}}"
            class="field-input"
            type="digit"
            value="{{fieldValues[item.key]}}"
            placeholder="请输入数值"
            disabled="{{saving || formLocked}}"
            data-field-key="{{item.key}}"
            bindinput="onFieldInput"
          />
          <picker
            wx:elif="{{item.type === 'single_choice'}}"
            class="choice-picker"
            range="{{item.options}}"
            range-key="label"
            value="{{fieldChoiceIndexes[item.key] || 0}}"
            disabled="{{saving || formLocked}}"
            data-field-key="{{item.key}}"
            bindchange="onChoiceChange"
          >
            <view class="picker-value">
              <view>
                {{selectedChoiceLabels[item.key] || "请选择"}}
              </view>
              <view class="picker-value__arrow">⌄</view>
            </view>
          </picker>
          <input
            wx:else
            id="record-field-{{item.key}}"
            class="field-input"
            type="text"
            maxlength="100"
            value="{{fieldValues[item.key]}}"
            placeholder="请输入{{item.label}}"
            disabled="{{saving || formLocked}}"
            data-field-key="{{item.key}}"
            bindinput="onFieldInput"
          />
          <view wx:if="{{item.unit}}" class="field-unit">{{item.unit}}</view>
        </view>
      </view>
    </view>

    <view class="form-card">
      <block wx:if="{{mode === 'recurring'}}">
        <view class="field-label">有效日期</view>
        <view class="date-time-row">
          <picker
            mode="date"
            value="{{startDate}}"
            disabled="{{saving || formLocked}}"
            bindchange="onStartDateChange"
          >
            <view class="date-time-value">{{startDate}}</view>
          </picker>
          <picker
            mode="date"
            value="{{endDate}}"
            disabled="{{saving || formLocked}}"
            bindchange="onEndDateChange"
          >
            <view class="date-time-value">{{endDate}}</view>
          </picker>
        </view>

        <view class="field-group">
          <view class="field-label">重复方式</view>
          <picker
            range="{{repeatTypes}}"
            range-key="label"
            value="{{repeatTypeIndex}}"
            disabled="{{saving || formLocked}}"
            bindchange="onRepeatTypeChange"
          >
            <view class="picker-value">
              <view>{{repeatTypes[repeatTypeIndex].label}}</view>
              <view class="picker-value__arrow">⌄</view>
            </view>
          </picker>

          <view wx:if="{{repeatType === 'weekly'}}" class="weekday-row">
            <button
              wx:for="{{weekdayOptions}}"
              wx:key="value"
              class="weekday-button {{item.selected ? 'weekday-button--selected' : ''}}"
              data-weekday="{{item.value}}"
              disabled="{{saving || formLocked}}"
              bindtap="onToggleWeekday"
            >
              {{item.label}}
            </button>
          </view>

          <view wx:if="{{repeatType === 'interval_days'}}" class="interval-row">
            <text>每隔</text>
            <input
              class="interval-input"
              type="number"
              value="{{intervalDays}}"
              disabled="{{saving || formLocked}}"
              bindinput="onIntervalDaysInput"
            />
            <text>天</text>
          </view>
          <view
            wx:if="{{repeatType === 'interval_days'}}"
            class="interval-hint"
          >
            例如填写 1：两个提醒日之间完整空出 1 天，也就是每 2 天一次。
          </view>
        </view>

        <view class="field-group">
          <view class="field-label">每天的提醒时间</view>
          <view
            wx:for="{{dailyTimeRows}}"
            wx:key="index"
            class="daily-time-row"
          >
            <picker
              mode="time"
              value="{{item.time}}"
              disabled="{{saving || formLocked}}"
              data-index="{{index}}"
              bindchange="onDailyTimeChange"
            >
              <view class="date-time-value">{{item.time}}</view>
            </picker>
            <button
              wx:if="{{dailyTimeRows.length > 1}}"
              class="small-text-button daily-time-remove"
              data-index="{{index}}"
              disabled="{{saving || formLocked}}"
              bindtap="onRemoveDailyTime"
            >
              移除
            </button>
          </view>
          <button
            class="secondary-button secondary-button--compact"
            disabled="{{saving || formLocked}}"
            bindtap="onAddDailyTime"
          >
            ＋ 添加一个时间
          </button>
        </view>
      </block>

      <block wx:else>
        <view class="field-label">{{timeLabel}}</view>
        <view class="date-time-row">
          <picker
            mode="date"
            value="{{occurredDate}}"
            disabled="{{saving || formLocked}}"
            bindchange="onDateChange"
          >
            <view class="date-time-value">{{occurredDate}}</view>
          </picker>
          <picker
            mode="time"
            value="{{occurredTime}}"
            disabled="{{saving || formLocked}}"
            bindchange="onTimeChange"
          >
            <view class="date-time-value">{{occurredTime}}</view>
          </picker>
        </view>

        <view wx:if="{{mode === 'reminder'}}" class="field-group">
          <view class="field-label">通知时间（选填，可添加多个）</view>
          <view class="form-hint">
            计划时间表示事项何时发生；通知时间表示何时提醒你。留空也能在每日健康中查看。
          </view>
          <view
            wx:for="{{notificationTimeRows}}"
            wx:key="index"
            class="notification-time"
          >
            <view class="date-time-row">
              <picker
                mode="date"
                value="{{item.date}}"
                disabled="{{saving || formLocked}}"
                data-index="{{index}}"
                bindchange="onNotificationDateChange"
              >
                <view class="date-time-value">{{item.date}}</view>
              </picker>
              <picker
                mode="time"
                value="{{item.time}}"
                disabled="{{saving || formLocked}}"
                data-index="{{index}}"
                bindchange="onNotificationTimeChange"
              >
                <view class="date-time-value">{{item.time}}</view>
              </picker>
            </view>
            <button
              class="small-text-button"
              disabled="{{saving || formLocked}}"
              data-index="{{index}}"
              bindtap="onRemoveNotificationTime"
            >
              移除这个通知时间
            </button>
          </view>
          <button
            class="secondary-button secondary-button--compact"
            disabled="{{saving || formLocked}}"
            bindtap="onAddNotificationTime"
          >
            ＋ 添加通知时间
          </button>
        </view>
      </block>

      <view class="field-group">
        <view class="field-label">{{remarkLabel}}</view>
        <view
          wx:if="{{mode === 'checkIn' && reminderRemark}}"
          class="reminder-note"
        >
          提醒说明：{{reminderRemark}}
        </view>
        <textarea
          id="record-remark-input"
          class="remark-input"
          value="{{remark}}"
          maxlength="500"
          auto-height
          disabled="{{saving || formLocked}}"
          placeholder="{{mode === 'reminder' || mode === 'recurring' ? '例如：饭后两小时测量' : '例如：晨起测量、饭后两小时'}}"
          bindinput="onRemarkInput"
        />
      </view>
    </view>

    <view
      wx:if="{{!reminderId && !ruleId && mode !== 'checkIn'}}"
      class="form-card"
    >
      <view class="form-card__title">临时字段（选填）</view>
      <view class="form-hint">
        只属于这条健康事项，保存后不能再改变字段结构；最多 3 个。
      </view>
      <view
        wx:for="{{temporaryFields}}"
        wx:key="index"
        class="temporary-field"
      >
        <input
          class="field-input standalone-input"
          maxlength="30"
          value="{{item.label}}"
          placeholder="字段名，例如：昨晚睡眠"
          disabled="{{saving || formLocked}}"
          data-index="{{index}}"
          data-property="label"
          bindinput="onTemporaryFieldInput"
        />
        <input
          class="field-input standalone-input"
          maxlength="100"
          value="{{item.value}}"
          placeholder="填写内容"
          disabled="{{saving || formLocked}}"
          data-index="{{index}}"
          data-property="value"
          bindinput="onTemporaryFieldInput"
        />
        <button
          class="small-text-button"
          disabled="{{saving || formLocked}}"
          data-index="{{index}}"
          bindtap="onRemoveTemporaryField"
        >
          移除
        </button>
      </view>
      <button
        wx:if="{{temporaryFields.length < 3}}"
        class="secondary-button"
        disabled="{{saving || formLocked}}"
        bindtap="onAddTemporaryField"
      >
        ＋ 添加临时字段
      </button>
    </view>

    <view wx:if="{{errorMessage}}" class="feedback">
      {{errorMessage}}
    </view>

    <button
      wx:if="{{ruleId}}"
      class="secondary-button"
      loading="{{saving}}"
      disabled="{{saving || formLocked}}"
      bindtap="onToggleRuleStatus"
    >
      {{ruleStatus === "paused" ? "恢复周期规则" : "暂停周期规则"}}
    </button>

    <button
      wx:if="{{mode === 'reminder' && reminderId}}"
      id="record-care-share-button"
      class="secondary-button"
      disabled="{{saving || formLocked}}"
      bindtap="onOpenCareShare"
    >
      分享给家人填写
    </button>

    <button
      id="record-save-button"
      class="primary-button"
      loading="{{saving}}"
      disabled="{{saving || formLocked}}"
      bindtap="onSave"
    >
      {{submitLabel}}
    </button>
  </view>
</view>
