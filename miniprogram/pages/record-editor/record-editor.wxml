<view class="editor-shell">
  <view class="editor-header">
    <view class="editor-header__eyebrow">{{familyName}}</view>
    <view class="editor-header__title">快速记录</view>
    <view class="editor-header__description">
      选择记录对象和模板，只填写当前需要的内容。
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="state-card">
    <view class="state-card__title">正在准备记录表单</view>
    <view class="state-card__description">请稍候</view>
  </view>

  <view wx:elif="{{status === 'error'}}" class="state-card state-card--error">
    <view class="state-card__title">暂时无法打开</view>
    <view class="state-card__description">{{errorMessage}}</view>
    <button
      wx:if="{{showGoHome}}"
      class="secondary-button"
      bindtap="onGoHome"
    >
      返回首页
    </button>
    <button
      wx:else
      class="secondary-button"
      bindtap="onRetry"
    >
      重新加载
    </button>
  </view>

  <view wx:else>
    <view class="form-card">
      <view class="field-group">
        <view class="field-label">记录谁的健康情况</view>
        <picker
          id="record-member-picker"
          range="{{members}}"
          range-key="displayLabel"
          value="{{selectedMemberIndex}}"
          disabled="{{saving}}"
          bindchange="onMemberChange"
        >
          <view class="picker-value">
            <view>
              {{selectedMember.displayLabel}}
            </view>
            <view class="picker-value__arrow">⌄</view>
          </view>
        </picker>
      </view>

      <view class="field-group">
        <view class="field-label">记录类型</view>
        <picker
          id="record-template-picker"
          range="{{templates}}"
          range-key="name"
          value="{{selectedTemplateIndex}}"
          disabled="{{saving}}"
          bindchange="onTemplateChange"
        >
          <view class="picker-value">
            <view>{{selectedTemplate.name}}</view>
            <view class="picker-value__arrow">⌄</view>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-card">
      <view class="form-card__title">{{selectedTemplate.name}}</view>
      <view
        wx:for="{{selectedTemplate.fields}}"
        wx:key="key"
        class="field-group"
      >
        <view class="field-label">
          {{item.label}}{{item.required ? "" : "（选填）"}}
        </view>
        <view class="input-with-unit">
          <input
            wx:if="{{item.type === 'number'}}"
            id="record-field-{{item.key}}"
            class="field-input"
            type="digit"
            value="{{fieldValues[item.key]}}"
            placeholder="请输入数值"
            disabled="{{saving}}"
            data-field-key="{{item.key}}"
            bindinput="onFieldInput"
          />
          <input
            wx:else
            id="record-field-{{item.key}}"
            class="field-input"
            type="text"
            maxlength="100"
            value="{{fieldValues[item.key]}}"
            placeholder="请输入{{item.label}}"
            disabled="{{saving}}"
            data-field-key="{{item.key}}"
            bindinput="onFieldInput"
          />
          <view wx:if="{{item.unit}}" class="field-unit">{{item.unit}}</view>
        </view>
      </view>
    </view>

    <view class="form-card">
      <view class="field-label">发生时间</view>
      <view class="date-time-row">
        <picker
          mode="date"
          value="{{occurredDate}}"
          disabled="{{saving}}"
          bindchange="onDateChange"
        >
          <view class="date-time-value">{{occurredDate}}</view>
        </picker>
        <picker
          mode="time"
          value="{{occurredTime}}"
          disabled="{{saving}}"
          bindchange="onTimeChange"
        >
          <view class="date-time-value">{{occurredTime}}</view>
        </picker>
      </view>

      <view class="field-group">
        <view class="field-label">备注（选填）</view>
        <textarea
          id="record-remark-input"
          class="remark-input"
          value="{{remark}}"
          maxlength="500"
          auto-height
          disabled="{{saving}}"
          placeholder="例如：晨起测量、饭后两小时"
          bindinput="onRemarkInput"
        />
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="feedback">
      {{errorMessage}}
    </view>

    <button
      id="record-save-button"
      class="primary-button"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="onSave"
    >
      保存记录
    </button>
  </view>
</view>
