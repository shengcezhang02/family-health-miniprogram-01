.analysis-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 36rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #f6f3ee;
}

.analysis-header__eyebrow {
  color: #d95c4f;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.analysis-header__title {
  margin-top: 16rpx;
  color: #202825;
  font-size: 52rpx;
  font-weight: 750;
}

.analysis-header__description {
  margin-top: 12rpx;
  color: #66716d;
  font-size: 25rpx;
  line-height: 1.7;
}

.state-card {
  margin-top: 60rpx;
  padding: 36rpx;
  border: 1rpx solid #e2ddd5;
  border-radius: 16rpx;
  text-align: center;
  background: #ffffff;
}

.state-card__title {
  color: #202825;
  font-size: 30rpx;
  font-weight: 700;
}

.state-card__description {
  margin-top: 14rpx;
  color: #66716d;
  font-size: 25rpx;
}

.state-card--error {
  border: 1rpx solid rgba(179, 78, 73, 0.16);
}

.secondary-button {
  margin-top: 26rpx;
  border: 0;
  border-radius: 12rpx;
  color: #2e6f68;
  font-size: 25rpx;
  font-weight: 700;
  background: #e7f0ed;
}

.secondary-button::after,
.analysis-card::after {
  border: 0;
}

.analysis-list {
  display: flex;
  align-items: stretch;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 38rpx;
}

.analysis-card {
  display: flex;
  width: 100%;
  min-width: 100%;
  align-self: stretch;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 28rpx;
  border: 1rpx solid #e2ddd5;
  border-left: 7rpx solid #4d6f8d;
  border-radius: 14rpx;
  color: #202825;
  text-align: left;
  background: #ffffff;
}

.analysis-card--1 {
  border-left-color: #d95c4f;
}

.analysis-card--2 {
  border-left-color: #2e6f68;
}

.analysis-card--3 {
  border-left-color: #c58a36;
}

.analysis-card__body {
  flex: 1;
}

.analysis-card__title {
  color: #202825;
  font-size: 31rpx;
  font-weight: 700;
}

.analysis-card__description {
  margin-top: 10rpx;
  color: #66716d;
  font-size: 24rpx;
  line-height: 1.6;
}

.analysis-card__status {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #8a5b19;
  font-size: 21rpx;
  background: #f6edda;
}

.analysis-card__arrow {
  margin-left: 20rpx;
  color: #7c8581;
  font-size: 48rpx;
}
